---
// Home page. Direction: "the sentence is the layout". The public address a server
// gets (<name>.play.minekube.net) is the page's subject; a real Minecraft world sits
// inside the headline where a word would be.
const bands = [
  {title: 'Players join without port forwarding.', more: 'The Connector opens an outbound tunnel from your machine. Nothing on your router changes, and localhost works.', link: '/guide/localhost', on: true},
  {title: 'Attacks hit the edge, never your IP.', more: 'Players reach a shared Anycast address. Your own IP is never published, so floods stop at the Connect Edge.', link: '/guide/tunnels'},
  {title: 'Every server gets a free domain.', more: 'NAME.play.minekube.net out of the box, or point your own domain at it with one CNAME record.', link: '/guide/domains', on: true},
  {title: 'Bedrock players use the same address.', more: 'Xbox-signed-in Bedrock players are translated at the edge. No Geyser plugin, no second proxy.', link: '/guide/bedrock'},
  {title: 'Players find you in the Browser Hub.', more: 'Anyone who joins minekube.net or types /browser can browse localhost and public servers side by side.', link: '/guide/advertising'},
]

const stages = [
  {name: 'Install', clause: 'Drop in the plugin', show: 1},
  {name: 'Start', clause: 'Start your server', show: 3},
  {name: 'Share', clause: 'Share your address', show: 4},
  {name: 'Join', clause: 'Friends join by name', show: 6},
]

// Real messages from the Minekube community (shown on the previous landing page).
const voices = [
  {who: 'Zed at CubeCraft', said: 'Your Minekube project caught our attention, and it’s great to connect with others doing cool stuff in the Minecraft tech space.'},
  {who: 'Joshua at JustChunks', said: 'It is extremely interesting to see Minekube evolve.'},
  {who: 'emortal', said: 'Gate has revived my love for Go. The SimpleProxy is surprisingly good at covering all bases like scheduling, messages, Brigadier and events.'},
  {who: 'NixNux123', said: 'The instructions for the setup are clear and easy to understand. The custom domain feature is great and works perfectly.'},
  {who: 'Akos', said: 'I like this project so much, I would even be happy to host my own gateway and allow others to use it.'},
  {who: 'Cerberus at PricelessKeys', said: 'I’m working on a cloud system in Go and want to support Gate to make it more extendable.'},
  {who: 'Dylan', said: 'Thanks for making some cool software, Minekube.'},
]
---

<div class="mk-home not-content">
  <section class="hero" aria-labelledby="_top">
    <h1 id="_top" class="hero-line">
      <span class="w" data-in>Your world</span>
      <span class="strip" data-shutter>
        <img src="/images/home/overworld.jpg" width="1494" height="791" alt="A Minecraft landscape: a river winding between blocky trees under square clouds" fetchpriority="high" />
      </span>
      <span class="w" data-in>online</span>
    </h1>
    <div class="hero-foot" data-in>
      <p class="lead">Minekube Connect gives any Minecraft server, even one on localhost, a free public address and DDoS protection. No port forwarding.</p>
      <div class="hero-actions">
        <a class="btn primary" href="/guide/quick-start">Start the quick setup</a>
        <a class="link" href="/guide/">Read the docs</a>
      </div>
    </div>
  </section>

  <figure class="vista" data-in>
    <img src="/images/home/taiga.jpg" width="1920" height="960" loading="lazy" alt="A Minecraft taiga: spruce forest on terraced hills beside a lake" />
    <figcaption>Wherever your server runs, players arrive through the Connect Edge nearest to them.</figcaption>
  </figure>

  <section class="bands" aria-label="What Connect does">
    {bands.map((b, i) => (
      <div class={`band band-${i}`} data-on={b.on ? '' : undefined} data-in>
        <div class="band-text">
          <h2>{b.title}</h2>
          <p class="band-more" id={`band-more-${i}`}>{b.more} <a href={b.link}>Learn how</a></p>
        </div>
        <button class="switch" role="switch" aria-checked={b.on ? 'true' : 'false'} aria-controls={`band-more-${i}`} aria-label={`Show details: ${b.title}`} data-ui>
          <span class="knob"></span>
        </button>
      </div>
    ))}
  </section>

  <section class="stages" aria-labelledby="stage-clause" data-stage="4">
    <div class="stage-copy">
      <h2 id="stage-clause" aria-live="polite" data-in>{stages[3].clause}</h2>
      <form class="endpoint" data-in onsubmit="return false">
        <label for="endpoint-name">Pick an endpoint name</label>
        <input id="endpoint-name" name="endpoint" value="live-beru" maxlength="32" autocomplete="off" spellcheck="false" />
        <p class="address"><span class="addr-name">live-beru</span>.play.minekube.net</p>
        <button type="button" class="copy" data-copy>Copy address</button>
      </form>
    </div>
    <figure class="stage-shot" data-in>
      <pre class="console" data-ui aria-label="Server console showing the Connect plugin enabling and players joining"><code><span class="cl" data-line="1"><span class="dim">plugins/</span> connect.jar</span>
<span class="cl" data-line="2"><span class="dim">[connect]</span> Enabling connect</span>
<span class="cl" data-line="3"><span class="dim">[connect]</span> Endpoint name: <b class="addr-name">live-beru</b></span>
<span class="cl" data-line="4"><span class="dim">[connect]</span> Your public address: <b><span class="addr-name">live-beru</span>.play.minekube.net</b></span>
<span class="cl joined" data-line="5">Steve joined the game</span>
<span class="cl joined" data-line="6">Alex joined the game <span class="dim">(Bedrock)</span></span></code></pre>
      <figcaption>The console of a Paper server running the Connect plugin.</figcaption>
    </figure>
    <div class="stage-rail">
      <input type="range" min="1" max="4" step="1" value="4" aria-label="Setup stage" aria-valuetext={stages[3].name} />
      <ol class="stage-names">
        {stages.map((s, i) => <li data-i={i + 1}>{s.name}</li>)}
      </ol>
    </div>
    <script type="application/json" id="stage-data" set:html={JSON.stringify(stages)}></script>
  </section>

  <section class="hub" aria-labelledby="hub-title">
    <h2 id="hub-title" class="hub-type"><span class="hub-l muted">Browse</span> <span class="hub-l">localhost</span></h2>
    <img class="hub-shot" src="/images/browser-hub.png" width="3840" height="2214" loading="lazy" alt="The Connect Browser Hub in Minecraft: a player standing in the lobby with the banner ‘Browse localhost & public servers!’" />
    <div class="hub-facts" data-in>
      <p>Join <strong>minekube.net</strong>, or type <code>/browser</code> on any connected server, and you land in the Browser Hub: one lobby listing localhost and public servers side by side.</p>
      <p>Advertising there is free and favours new and smaller servers. <a href="/guide/advertising">How advertising works</a></p>
    </div>
  </section>

  <section class="voices" aria-labelledby="voices-title">
    <p class="voice-run" data-in>
      <span id="voices-title" class="voice-head">Kind words about Minekube from</span>{' '}
      {voices.map((v, i) => (
        <><span class="voice-name" data-v={i} aria-current={i === 0 ? 'true' : undefined}>{v.who}</span>{i < voices.length - 1 ? ', ' : '.'}</>
      ))}
    </p>
    <div class="voice-row">
    <figure class="voice-pic" data-in>
      <img src="/images/home/server-build.jpg" width="1512" height="991" loading="lazy" alt="A towering player-built statue among bamboo and cherry trees on a Minecraft server" />
      <figcaption>A player build on the EarthMC server.</figcaption>
    </figure>
    <blockquote class="voice-quote" aria-live="polite" data-in>
      <p>{voices[0].said}</p>
      <footer>{voices[0].who}</footer>
    </blockquote>
    </div>
    <script type="application/json" id="voice-data" set:html={JSON.stringify(voices)}></script>
  </section>

  <section class="ask" aria-labelledby="ask-title">
    <h2 id="ask-title"><span>Ready to</span> <span>go public?</span></h2>
    <div class="ask-mid">
    <div class="ask-row">
      <a class="btn primary" href="/guide/quick-start">Quick start</a>
      <span class="or">or</span>
      <a class="btn" href="https://minekube.com/discord">Ask on Discord</a>
    </div>
    <p class="ask-note">Setup is one plugin and a restart. The #support forum on Discord answers the rest.</p>
    </div>
  </section>

  <footer class="close" aria-labelledby="close-title">
    <div class="close-top">
      <div>
        <h2 id="close-title">Join the Connect Network</h2>
        <a class="btn ink" href="https://app.minekube.com">Open the dashboard</a>
      </div>
      <ul class="close-links">
        <li><a href="https://minekube.com/discord">Discord</a></li>
        <li><a href="https://github.com/minekube/connect-java">GitHub</a></li>
        <li><a href="https://x.com/minekube">X</a></li>
        <li><a href="https://gate.minekube.com">Gate proxy</a></li>
      </ul>
    </div>
    <div class="close-legal">
      <span>© {new Date().getFullYear()} Minekube and contributors. Not affiliated with Mojang or Minecraft.</span>
      <span>Pictures: <a href="https://commons.wikimedia.org/wiki/File:Minecraft_Beta_1.8.1_Gameplay_Screenshot.png">“Minecraft Beta 1.8.1 Gameplay Screenshot”</a> and <a href="https://commons.wikimedia.org/wiki/File:Minecraft_-_Taiga.jpg">“Minecraft - Taiga”</a> by Xbox México, <a href="https://creativecommons.org/licenses/by/3.0">CC BY 3.0</a>; <a href="https://commons.wikimedia.org/wiki/File:Earthmc%E5%AE%89%E5%BA%86%E5%BA%9C%E8%8F%B2%E6%AF%94%E5%83%8F.png">EarthMC statue</a> by 辰潇, CC0. All via Wikimedia Commons.</span>
    </div>
    <div class="close-mark" aria-hidden="true">Minekube</div>
  </footer>
</div>

<script>
  const root = document.querySelector('.mk-home')!
  root.classList.add('js')

  // Feature bands: each switch opens its consequence line.
  root.querySelectorAll<HTMLButtonElement>('.switch').forEach((sw) => {
    sw.addEventListener('click', () => {
      const band = sw.closest('.band')!
      const on = sw.getAttribute('aria-checked') !== 'true'
      sw.setAttribute('aria-checked', String(on))
      band.toggleAttribute('data-on', on)
    })
  })

  // Setup stages: the slider drives the clause and the console.
  const stages = JSON.parse(document.getElementById('stage-data')!.textContent!)
  const sec = root.querySelector<HTMLElement>('.stages')!
  const range = sec.querySelector<HTMLInputElement>('input[type=range]')!
  const clause = sec.querySelector('#stage-clause')!
  const setStage = (n: number) => {
    const s = stages[n - 1]
    sec.dataset.stage = String(n)
    clause.textContent = s.clause
    range.setAttribute('aria-valuetext', s.name)
    sec.querySelectorAll<HTMLElement>('.cl').forEach((l) => l.classList.toggle('off', Number(l.dataset.line) > s.show))
    sec.querySelectorAll<HTMLElement>('.stage-names li').forEach((li) => li.toggleAttribute('data-current', Number(li.dataset.i) === n))
    range.style.setProperty('--p', `${((n - 1) / 3) * 100}%`)
  }
  range.addEventListener('input', () => setStage(Number(range.value)))
  sec.querySelectorAll<HTMLElement>('.stage-names li').forEach((li) =>
    li.addEventListener('click', () => { range.value = li.dataset.i!; setStage(Number(li.dataset.i)) }))
  setStage(4)

  // The live thing: type an endpoint name, see the public address it gets.
  const input = sec.querySelector<HTMLInputElement>('#endpoint-name')!
  const names = sec.querySelectorAll('.addr-name')
  const clean = (v: string) => v.toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-+/, '').slice(0, 32) || 'live-beru'
  input.addEventListener('input', () => names.forEach((n) => (n.textContent = clean(input.value))))
  const copy = sec.querySelector<HTMLButtonElement>('[data-copy]')!
  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(`${clean(input.value)}.play.minekube.net`)
      copy.textContent = 'Copied'
    } catch {
      copy.textContent = 'Select and copy'
    }
    setTimeout(() => (copy.textContent = 'Copy address'), 1600)
  })

  // Voices: one name lit at a time, its words underneath.
  const voices = JSON.parse(document.getElementById('voice-data')!.textContent!)
  const nameEls = [...root.querySelectorAll<HTMLElement>('.voice-name')]
  const quote = root.querySelector('.voice-quote')!
  let v = 0
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
  const light = (i: number) => {
    nameEls.forEach((el, j) => (j === i ? el.setAttribute('aria-current', 'true') : el.removeAttribute('aria-current')))
    quote.querySelector('p')!.textContent = voices[i].said
    quote.querySelector('footer')!.textContent = voices[i].who
  }
  nameEls.forEach((el, i) => el.addEventListener('click', () => { v = i; light(i) }))
  if (!reduce) setInterval(() => { v = (v + 1) % voices.length; light(v) }, 4000)

  // The closing wordmark fills the width exactly.
  const mark = root.querySelector<HTMLElement>('.close-mark')!
  const fit = () => {
    mark.style.fontSize = '100px'
    const box = mark.parentElement!
    const avail = box.clientWidth - parseFloat(getComputedStyle(box).paddingLeft) * 2
    mark.style.fontSize = `${(100 * avail) / mark.scrollWidth}px`
  }
  document.fonts.ready.then(fit)
  addEventListener('resize', fit)

  // Entrances: each part rises once as its section arrives.
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return
      e.target.querySelectorAll<HTMLElement>('[data-in]').forEach((el, i) => el.style.setProperty('--d', `${i * 80}ms`))
      e.target.classList.add('in')
      io.unobserve(e.target)
    })
  }, {threshold: 0.15})
  root.querySelectorAll('section, footer.close, figure.vista').forEach((s) => io.observe(s))
</script>

<style is:global>
  /* Full-bleed canvas: drop the splash container padding on the home page. */
  .content-panel:has(.mk-home) { padding: 0 !important; border: 0; }
  .content-panel:has(.mk-home) .sl-container { max-width: none !important; margin: 0; }
  .content-panel:has(.mk-home) .sl-markdown-content { margin: 0; }
</style>

<style>
  .mk-home {
    --ground: var(--sl-color-black);
    --ink: var(--sl-color-white);
    --muted: var(--sl-color-gray-3);
    --field: var(--sl-color-gray-6);
    --accent: var(--mk-orange);
    --m: clamp(1rem, 2vw, 1.75rem);
    --gap: clamp(7.5rem, 12vw, 12rem);
    --display: 'Archivo Variable', var(--sl-font);
    color: var(--ink);
    background: var(--ground);
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.5;
    overflow-x: clip;
  }
  .mk-home :where(h1, h2, p, blockquote, figure, ol, ul) { margin: 0; }
  .mk-home :where(a) { color: inherit; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3.25rem; padding: 0 1.5rem;
    font-weight: 600; font-size: 1.0625rem; text-decoration: none;
    border-radius: 0; background: var(--field); color: var(--ink);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .btn.primary { background: var(--accent); color: #140a02; }
  .btn.ink { background: var(--ground); color: var(--ink); }
  .btn:hover { transform: translateY(-2px); }
  .btn:active { transform: translateY(1px); }
  .btn:focus-visible, .link:focus-visible, .switch:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  /* ---------------- hero ---------------- */
  .hero {
    min-height: calc(100svh - var(--sl-nav-height));
    padding: clamp(2rem, 6vh, 4rem) var(--m) clamp(2rem, 5vh, 3.5rem);
    display: grid; grid-template-rows: 1fr auto; align-items: center;
  }
  .hero-line {
    display: flex; align-items: baseline; gap: 0.18em; width: 100%;
    font-family: var(--display); font-weight: 800; font-stretch: 62%;
    font-size: 9.2vw; line-height: 0.86; letter-spacing: -0.01em; text-transform: uppercase;
    color: var(--ink); white-space: nowrap;
  }
  .strip {
    flex: 1; min-width: 1.6em; height: 0.72em; display: block; overflow: hidden;
    border-radius: 0.09em; align-self: baseline; position: relative; top: 0;
  }
  .strip img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 42%; display: block; }
  .hero-foot {
    display: grid; grid-template-columns: minmax(0, 36rem) auto; justify-content: space-between; align-items: end; gap: 2rem;
  }
  .lead { font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem); line-height: 1.35; max-width: 36rem; }
  .hero-actions { display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap; }
  .link { font-weight: 600; text-underline-offset: 0.25em; text-decoration-color: var(--accent); }

  /* ---------------- feature bands ---------------- */
  .bands { margin-top: var(--gap); }
  .band {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2rem;
    min-height: 20vh; padding: 1.75rem var(--m);
    background: var(--ground); transition: background-color 0.35s ease;
  }
  .band + .band { box-shadow: none; }
  .band h2 {
    font-family: var(--display); font-weight: 700; font-stretch: 80%;
    font-size: clamp(1.75rem, 1rem + 2.6vw, 3.4rem); line-height: 1.02; letter-spacing: -0.02em;
    color: var(--muted); transition: color 0.35s ease;
  }
  .band-more { max-height: 0; overflow: hidden; opacity: 0; visibility: hidden; max-width: 46rem; font-size: 1.0625rem;
    transition: max-height 0.4s ease, opacity 0.3s ease, margin 0.3s ease; }
  .band-more a { font-weight: 600; }
  .band[data-on] h2 { color: #120a03; }
  .band[data-on] .band-more { max-height: 8rem; opacity: 1; visibility: visible; margin-top: 0.75rem; color: #120a03; }
  .band-0[data-on] { background: #f38020; }
  .band-1[data-on] { background: #e8eaed; }
  .band-2[data-on] { background: #7cbd4f; }
  .band-3[data-on] { background: #5fd0dc; }
  .band-4[data-on] { background: #f5c542; }
  .switch {
    all: unset; cursor: pointer; box-sizing: border-box;
    width: clamp(3.5rem, 5vw, 5rem); height: clamp(2rem, 2.8vw, 2.75rem);
    padding: 0.25rem; background: var(--field); display: flex; align-items: center;
    transition: background-color 0.25s ease;
  }
  .knob { width: 45%; aspect-ratio: 1; height: auto; max-height: 100%; background: var(--muted); transition: transform 0.25s ease, background-color 0.25s ease; }
  .band[data-on] .switch { background: #120a03; }
  .band[data-on] .knob { background: #fff; transform: translateX(122%); }
  .switch:hover .knob { transform: scale(0.92); }
  .band[data-on] .switch:hover .knob { transform: translateX(122%) scale(0.92); }

  /* ---------------- stages + live endpoint ---------------- */
  .stages {
    margin-top: var(--gap);
    display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr auto;
    min-height: 88svh;
  }
  .stage-copy { background: var(--field); padding: clamp(2rem, 4vw, 3.5rem) var(--m); display: flex; flex-direction: column; justify-content: space-between; gap: 3rem; }
  .stage-copy h2 {
    font-family: var(--display); font-weight: 800; font-stretch: 70%; text-transform: uppercase;
    font-size: clamp(2.5rem, 1.2rem + 4.4vw, 5.25rem); line-height: 0.9; letter-spacing: -0.01em;
  }
  .endpoint { display: grid; gap: 0.6rem; max-width: 34rem; }
  .endpoint label { font-weight: 600; }
  .endpoint input {
    font: inherit; font-size: 1.25rem; padding: 0.85rem 1rem; border: 0; border-radius: 0;
    background: var(--ground); color: var(--ink); outline: 2px solid transparent;
  }
  .endpoint input:focus { outline-color: var(--accent); }
  .address { font-family: var(--display); font-weight: 700; font-stretch: 85%; font-size: clamp(1.4rem, 1rem + 1.4vw, 2.1rem); line-height: 1.1; overflow-wrap: anywhere; margin-top: 0.75rem; }
  .address .addr-name { color: var(--accent); }
  .copy { justify-self: start; font: inherit; font-weight: 600; cursor: pointer; border: 0; padding: 0.6rem 1rem; background: var(--ink); color: var(--ground); transition: transform 0.15s ease; }
  .copy:hover { transform: translateY(-2px); }
  .stage-shot { background: #17110a; display: grid; place-content: center; gap: 1rem; padding: 2.5rem var(--m); }
  .console {
    margin: 0; white-space: pre-wrap; overflow-wrap: anywhere;
    width: min(100%, 30rem); background: #24190e; color: #f4ece2; padding: 1.5rem 1.6rem;
    font-family: var(--sl-font-mono); font-size: 0.95rem; line-height: 1.75; border-radius: 0.375rem;
  }
  .console code { font: inherit; background: none; padding: 0; color: inherit; }
  .console .cl { transition: opacity 0.25s ease; }
  .console .dim { color: #b49a7d; }
  .console b { color: #ffb066; font-weight: 600; }
  .console .joined { color: #f5d76e; }
  .console .off { opacity: 0; }
  .stage-shot figcaption { color: #c9b8a4; font-size: 0.875rem; }
  .stage-rail { grid-column: 1 / -1; padding: 1.75rem var(--m) 0; }
  .stage-rail input[type=range] {
    --p: 100%;
    -webkit-appearance: none; appearance: none; width: 100%; height: 8px; margin: 1rem 0; cursor: pointer;
    background: linear-gradient(to right, var(--ink) var(--p), var(--field) var(--p));
  }
  .stage-rail input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 32px; height: 32px; background: var(--accent); border: 0; border-radius: 0; }
  .stage-rail input[type=range]::-moz-range-thumb { width: 32px; height: 32px; background: var(--accent); border: 0; border-radius: 0; }
  .stage-rail input[type=range]:focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; }
  .stage-names { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .stage-names li { color: var(--muted); cursor: pointer; font-weight: 500; }
  .stage-names li:nth-child(2) { text-align: center; transform: translateX(-17%); }
  .stage-names li:nth-child(3) { text-align: center; transform: translateX(17%); }
  .stage-names li:last-child { text-align: right; }
  .stage-names li[data-current] { color: var(--ink); font-weight: 700; }

  /* ---------------- browser hub: object in front of type ---------------- */
  .hub {
    margin-top: var(--gap); padding: 0 var(--m);
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(1.5rem, 3vw, 3rem); align-items: start;
  }
  .hub-type { font-family: var(--display); font-weight: 800; font-stretch: 62%; text-transform: uppercase; margin: 0; display: grid; }
  .hub-l { font-size: clamp(4rem, 1rem + 8.4vw, 9.5rem); line-height: 0.86; letter-spacing: -0.01em; color: var(--ink); }
  .hub-l.muted { color: var(--muted); }
  .hub-shot { grid-column: 2; grid-row: 1 / span 2; width: 100%; height: auto; transform: rotate(-2deg); border-radius: 0.25rem; margin-top: 1rem; }
  .hub-facts { grid-column: 1; margin-top: 2.5rem; display: grid; gap: 1.1rem; font-size: 1.1875rem; max-width: 30rem; }
