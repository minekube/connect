---
import PixelIcon from './PixelIcon.astro'

const features = [
  {icon: 'shield', title: 'Ingress for Minecraft Servers', details: 'Protect Minecraft servers from attacks with Minekube Connect.', link: '/guide/quick-start', linkText: 'Managed Ingress for Minecraft'},
  {icon: 'tunnel', title: 'Connect Tunnels', details: 'As if Cloudflare Tunnel and Minekube Gate proxy had a baby.', link: '/guide/tunnels', linkText: 'About Tunnels'},
  {icon: 'laptop', title: 'No more Port Forwarding', details: 'Let your friends join localhost by NAME.play.minekube.net', link: '/guide/localhost', linkText: 'Run locally, play publicly'},
  {icon: 'sparkle', title: 'Free Public Domain', details: "Don't have a domain? Get a free public domain for every server.", link: '/guide/domains', linkText: 'Public Domains'},
  {icon: 'network', title: 'Shared Minecraft Network', details: 'Securely connect to the open Connect Network to link and advertise your game servers.', link: '/guide/#the-connect-network', linkText: 'The Connect Network'},
  {icon: 'controller', title: 'Java and Bedrock Access', details: 'Let Bedrock players join connected endpoints through the same domains Java players use.', link: '/guide/bedrock', linkText: 'Bedrock Support'},
  {icon: 'chest', title: 'Quick Installation', details: 'All you need is the Connect Plugin to link your game servers with the open Connect Network.', link: '/guide/quick-start', linkText: 'Installation'},
  {icon: 'megaphone', title: 'Advertise Your Server', details: 'Get your server in front of players with organic traffic.', link: '/guide/advertising', linkText: 'Advertising'},
  {icon: 'scroll', title: 'Product Changelog', details: 'Follow hosted Connect deployments, upgrade releases, and resolved incidents across Minekube.', link: '/changelog/', linkText: 'See what changed'},
  {icon: 'clover', title: 'Equal Opportunity', details: 'Connect is a fair and equal opportunity platform that favours new and smaller servers.', link: '/guide/adoption-plan', linkText: 'Adoption Plan'},
]
---

<div class="mk-home not-content">
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="copy">
      <a class="eyebrow" href="/guide/">
        <span class="dot" aria-hidden="true"></span>
        Connect → The Minecraft native Superproxy
      </a>
      <h1 id="_top">The Ingress Tunnel for <span class="hl">Minecraft</span> Servers</h1>
      <p class="tagline">A global gateway to a DDoS-protected developer platform with public domains for localhost.</p>
      <div class="actions">
        <a class="btn primary" href="/guide/quick-start">Quick Setup</a>
        <a class="btn" href="/guide/connectors/plugin#downloading-the-connect-plugin">Download Plugin</a>
      </div>
      <p class="sub-links">
        <a href="https://app.minekube.com">Dashboard ↗</a>
        <a href="https://minekube.com/discord">Join Discord ↗</a>
        <a href="https://gate.minekube.com">Gate Proxy ↗</a>
      </p>
    </div>

    <figure class="terminal" aria-label="Server console after installing the Connect plugin">
      <div class="term-bar"><span></span><span></span><span></span><em>Server Console</em></div>
      <pre><code><span class="c-muted">$</span> java -jar paper.jar
<span class="c-muted">[connect]</span> Enabling connect vX.Y.Z
<span class="c-muted">[connect]</span> Endpoint name: <span class="c-accent">live-beru</span>
<span class="c-muted">[connect]</span> Your public address: <span class="c-accent">live-beru.play.minekube.net</span>
<span class="c-yellow">Steve joined the game</span>
<span class="c-yellow">Alex joined the game</span> <span class="c-muted">(Bedrock)</span><span class="cursor" aria-hidden="true"></span></code></pre>
      <figcaption>Install the plugin, start your server, share the address. No port forwarding.</figcaption>
    </figure>
  </section>

  <section class="features" aria-labelledby="features-title">
    <div class="section-head">
      <p class="kicker">Features</p>
      <h2 id="features-title">Everything between your server and your players</h2>
    </div>
    <ul class="feature-grid">
      {features.map((f) => (
        <li>
          <a href={f.link} class="mk-card">
            <span class="icon"><PixelIcon name={f.icon as any} size={28} /></span>
            <h3>{f.title}</h3>
            <p>{f.details}</p>
            <span class="more">{f.linkText} <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <slot />

  <section class="cta">
    <div class="grid-bg" aria-hidden="true"></div>
    <h2>Get your server online in minutes</h2>
    <p>Drop the Connect plugin into Paper, Velocity or BungeeCord, or enable it in Gate. Players join by name, from Java or Bedrock.</p>
    <div class="actions">
      <a class="btn primary" href="/guide/quick-start">Start the Quick Start</a>
      <a class="btn" href="/guide/connectors/">Choose a connector</a>
    </div>
  </section>
</div>

<style>
  .mk-home { overflow-x: clip; }
  .hero {
    position: relative; display: grid; gap: 3rem; align-items: center;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    padding: clamp(2.5rem, 7vw, 5.5rem) 0 clamp(3rem, 6vw, 5rem);
  }
  .grid-bg {
    position: absolute; inset: 0 -50vw; z-index: -1; pointer-events: none;
    background-image:
      linear-gradient(var(--mk-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--mk-grid) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 60% 70% at 50% 40%, #000 30%, transparent 75%);
  }
  .hero::before {
    content: ''; position: absolute; z-index: -1; width: 38rem; height: 26rem; right: -6rem; top: 2rem; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--mk-orange) 22%, transparent), transparent),
                radial-gradient(closest-side at 70% 70%, color-mix(in srgb, var(--mk-purple) 16%, transparent), transparent);
    filter: blur(20px);
  }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.35rem 0.8rem 0.35rem 0.6rem;
    border: 1px solid var(--sl-color-hairline-light); border-radius: 0.375rem;
    font-family: var(--mk-font-pixel); font-size: 0.85rem; letter-spacing: 0.02em;
    color: var(--sl-color-gray-2); text-decoration: none; background: color-mix(in srgb, var(--sl-color-black) 70%, transparent);
  }
  .eyebrow:hover { border-color: var(--sl-color-accent); color: var(--sl-color-white); }
  .dot { width: 8px; height: 8px; background: var(--mk-grass); box-shadow: 0 0 0 3px color-mix(in srgb, var(--mk-grass) 25%, transparent); }
  h1 {
    margin: 1.5rem 0 0; font-size: clamp(2.5rem, 5.6vw, 4.25rem); line-height: 1.02; font-weight: 700;
    letter-spacing: -0.045em; color: var(--sl-color-white); text-wrap: balance;
  }
  .hl { font-family: var(--mk-font-pixel); font-weight: 700; letter-spacing: 0; color: var(--mk-orange); }
  .tagline { margin: 1.5rem 0 0; max-width: 34rem; font-size: 1.15rem; line-height: 1.6; color: var(--sl-color-gray-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .btn {
    display: inline-flex; align-items: center; padding: 0.7rem 1.15rem; border-radius: 0.375rem;
    font-weight: 600; font-size: 0.95rem; text-decoration: none; color: var(--sl-color-white);
    border: 1px solid var(--sl-color-hairline-light); background: var(--sl-color-black);
    box-shadow: 3px 3px 0 var(--sl-color-hairline-light); transition: transform 0.08s, box-shadow 0.08s;
  }
  .btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--sl-color-hairline-light); }
  .btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--sl-color-hairline-light); }
  .btn.primary { background: var(--mk-orange); border-color: var(--mk-orange); color: #160a01; box-shadow: 3px 3px 0 var(--mk-shadow); }
  .btn.primary:hover { box-shadow: 4px 4px 0 var(--mk-shadow); }
  .sub-links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.5rem; font-size: 0.875rem; }
  .sub-links a { color: var(--sl-color-gray-3); text-decoration: none; }
  .sub-links a:hover { color: var(--sl-color-white); }

  .terminal {
    margin: 0; border: 1px solid var(--sl-color-hairline-light); border-radius: 0.75rem; overflow: hidden;
    background: #0d0d0f; box-shadow: 6px 6px 0 color-mix(in srgb, var(--mk-orange) 55%, transparent);
  }
  .term-bar { display: flex; align-items: center; gap: 0.4rem; padding: 0.65rem 0.9rem; border-bottom: 1px solid #222226; background: #141417; }
  .term-bar span { width: 10px; height: 10px; background: #2c2c31; }
  .term-bar span:first-child { background: var(--mk-orange); }
  .term-bar em { margin-left: 0.5rem; font-style: normal; font-family: var(--sl-font-mono); font-size: 0.75rem; color: #8e8e96; }
  .terminal pre { margin: 0; padding: 1.1rem 1.2rem 1.3rem; overflow-x: auto; font-family: var(--sl-font-mono); font-size: 0.82rem; line-height: 1.85; color: #e4e4e7; background: transparent; border: 0; }
  .c-muted { color: #7a7a83; }
  .c-accent { color: #ffb070; }
  .c-yellow { color: #fde047; font-family: var(--mk-font-pixel); }
  .cursor { display: inline-block; width: 0.55em; height: 1.05em; margin-left: 0.3em; vertical-align: -0.15em; background: #e4e4e7; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }
  figcaption { padding: 0.75rem 1.2rem; border-top: 1px solid #222226; font-size: 0.8rem; color: #8e8e96; background: #111113; }

  .section-head { max-width: 40rem; margin-bottom: 2rem; }
  .kicker { margin: 0; font-family: var(--mk-font-pixel); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.85rem; color: var(--sl-color-accent); }
  .section-head h2 { margin: 0.5rem 0 0; font-size: clamp(1.75rem, 3.2vw, 2.4rem); line-height: 1.1; letter-spacing: -0.035em; color: var(--sl-color-white); }
  .feature-grid {
    list-style: none; margin: 0; padding: 0; display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr));
    border-top: 1px solid var(--sl-color-hairline-light); border-left: 1px solid var(--sl-color-hairline-light);
  }
  .feature-grid li { border-right: 1px solid var(--sl-color-hairline-light); border-bottom: 1px solid var(--sl-color-hairline-light); }
  .mk-card { display: flex; flex-direction: column; height: 100%; padding: 1.5rem; color: inherit; text-decoration: none; transition: background 0.15s; }
  .mk-card:hover { background: color-mix(in srgb, var(--sl-color-gray-6) 80%, transparent); }
  .icon { display: inline-flex; width: 2.75rem; height: 2.75rem; align-items: center; justify-content: center; border: 1px solid var(--sl-color-hairline-light); color: var(--mk-orange); background: var(--sl-color-black); }
  .mk-card h3 { margin: 1.1rem 0 0; font-size: 1rem; font-weight: 600; color: var(--sl-color-white); letter-spacing: -0.01em; }
  .mk-card p { margin: 0.45rem 0 0; font-size: 0.9rem; line-height: 1.55; color: var(--sl-color-gray-3); }
  .more { margin-top: auto; padding-top: 1rem; font-size: 0.85rem; font-weight: 500; color: var(--sl-color-gray-2); }
  .mk-card:hover .more { color: var(--sl-color-accent); }

  .cta { position: relative; margin: 4rem 0 2rem; padding: clamp(2rem, 5vw, 3.5rem); text-align: center; border: 1px solid var(--sl-color-hairline-light); border-radius: 0.75rem; overflow: hidden; }
  .cta .grid-bg { inset: 0; mask-image: radial-gradient(ellipse at 50% 120%, #000, transparent 70%); }
  .cta h2 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.2rem); letter-spacing: -0.035em; color: var(--sl-color-white); }
  .cta p { margin: 0.75rem auto 0; max-width: 36rem; color: var(--sl-color-gray-2); }
  .cta .actions { justify-content: center; }

  @media (max-width: 56rem) {
    .hero { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero::before { right: -12rem; }
  }
</style>
