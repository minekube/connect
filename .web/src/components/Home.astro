  /* the stage: one window that plays the current step */
  .stage { position: relative; min-height: 19rem; border-radius: 0.9rem; background: var(--ground); box-shadow: inset 0 0 0 1px var(--sl-color-hairline); overflow: hidden; }
  .win-bar { display: flex; align-items: center; height: 2.4rem; padding-inline: 1rem; border-bottom: 1px solid var(--sl-color-hairline); font-size: 0.8125rem; font-weight: 600; color: var(--muted); }
