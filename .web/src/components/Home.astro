  .scene { position: absolute; inset: 2.4rem 0 0; padding: 1.1rem; display: none; box-sizing: border-box; }
  .how[data-step='0']:not([data-pf='gate']) .sc-files, .how[data-step='0'][data-pf='gate'] .sc-config,
  .how[data-step='1'] .sc-console, .how[data-step='2'] .sc-join { display: grid; }

  /* step 1: file manager */
  .sc-files { grid-template-columns: 1fr 1fr; gap: 0.9rem; align-content: start; }
  .pane { min-width: 0; padding: 0.75rem; border-radius: 0.7rem; background: var(--field); align-self: stretch; box-sizing: border-box; }
  .crumb { margin: 0 0 0.6rem; font-size: 0.8125rem; font-weight: 600; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
