  .how-grid { margin-top: 1rem; display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 1rem; align-items: stretch; }

  .how-steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; align-content: center; }
