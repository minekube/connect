---
import Team from './Team.astro'
import {discordLink} from '../shared'

// Home page: each section answers one question for a visitor, in this order:
// what is it (hero + video), how does it work, does it fit my setup, what can I do
// with it, where do players find me, who uses it, where is it going, who builds it.
// Use cases: one situation each, written for the person in it.
const cases = [
  {who: 'For an SMP with friends', title: 'Host from your own PC', text: 'Run the server at home and friends join yourname.play.minekube.net. No port forwarding, no router settings.', link: '/guide/localhost', linkText: 'Play on localhost'},
  {who: 'For public servers', title: 'Keep attacks away from your machine', text: 'Players connect through the Connect edge, so your real IP is never published and floods stop before they reach you.', link: '/guide/protections', linkText: 'Server protections'},
  {who: 'For networks', title: 'Run a whole network behind one address', text: 'Put Gate or Velocity in front of your lobby and game servers. Connect delivers every player to your proxy.', link: '/guide/topologies', linkText: 'Pick a topology'},
  {who: 'For mixed player bases', title: 'Let Bedrock players join too', text: 'Phone, console and Windows players use the same address as Java players. No Geyser setup.', link: '/guide/bedrock', linkText: 'Bedrock support'},
  {who: 'For your brand', title: 'Use your own domain', text: 'Start with a free play.minekube.net address, then point play.yourserver.com at it with one DNS record.', link: '/guide/domains', linkText: 'Custom domains'},
  {who: 'For growing servers', title: 'Manage everything in one place', text: 'The Connect Dashboard keeps your endpoints, connectors and domains together, with stats about your network.', link: 'https://app.minekube.com', linkText: 'Open the dashboard'},
]

const products = [
  {name: 'Minekube Connect', text: 'You run the Connector, we run the edge network behind it.'},
  {name: 'Minekube Games', text: 'Bring the game, we bring the players, matchmaking and capacity.', soon: true},
  {name: 'Minekube Analytics', text: 'Learn who your players are and what they want to play next.', soon: true},
  {name: 'Minekube Developer Platform', text: 'Server search, reviews and votes, a marketplace and ads.', soon: true},
]

const capabilities = [
  {name: 'Edge tunnels', text: 'Protected entry points close to your players, wherever they are.'},
  {name: 'Anycast addresses', text: 'One public IP that routes every player to the nearest edge.'},
  {name: 'Quick to set up', text: 'One binary, container or plugin and a few lines of config. Any network layout works.'},
]

const testimonials = [
  {body: 'Hey, just wanted to reach out and say hi really! Your Minekube project caught our attention, and it’s great to connect with others doing cool stuff in the Minecraft tech space. Would love to have a call to introduce ourselves and hear about your story, plus trade stories of working with Minecraft in weird and wonderful ways', name: 'Zed - Managing Director', handle: 'cubecraft', avatar: '/images/avatars/zed.png'},
  {body: 'It is extremely interesting to see Minekube evolve', name: 'Joshua - CTO', handle: 'justchunks', avatar: '/images/avatars/joshua.png'},
  {body: 'Gradients in Gate. Added arguments to my NBS command, so I’m just jamming right now. Lol, it even supports server switching mid-song, which I assume wasn’t done before. However, Gate has revived my love for Go lol. The SimpleProxy is surprisingly good at covering all bases like scheduling, messages, Brigadier (plus suggestions), and events.', name: 'emortal', handle: 'emortalmc', avatar: '/images/avatars/emortal.png'},
  {body: 'It looks lovely! I have had a good time working on my project so far with Gate and am excited to see its progress.', name: 'Ö for{i}am꧂', handle: 'bgp179', avatar: '/images/avatars/foriam.webp'},
  {body: 'I’m working on a cloud system in Go and want to support Gate to enhance user experience and make it more extendable. Here’s the current version of the Go MC cloud system with a dashboard in action.', name: 'Cerberus - Founder PricelessKeys', handle: 'cerberus.labs', avatar: '/images/avatars/cerberus.webp'},
  {body: 'Thank you, I didn’t realize how braindead proxy protocol was, ended up using that. To those looking at a similar situation: it’s literally just ‘proxyprotocol: true’ in paper globals. Enable that on Gate and bada bing bada boom, you’re golden.', name: 'Server User'},
  {body: 'The instructions for the setup are clear and easy to understand. Both setups I tested are working perfectly, with Gate Lite routing the connection correctly. The custom domain feature is great and works perfectly. I appreciate the ability to manually trigger a refresh for the DNS-check.', name: 'NixNux123 - Admin', handle: 'FynnCraft', avatar: '/images/avatars/nixnux.png'},
  {body: 'I like this project so much, I would even be happy to host my own gateway and allow others to use it. I’m sure that people will eventually find Minekube.', name: 'Akos', handle: 'theforgtn', avatar: '/images/avatars/akos.png'},
  {body: 'Thanks for making some cool software Minekube', name: 'Dylan', handle: 'dilllxd', avatar: '/images/avatars/dylan.png'},
]

// One-click downloads for the hero (same files as the Downloads page).
const rel = 'https://github.com/minekube/connect-java/releases/download/latest'
const downloads = [
  {name: 'Paper / Spigot', short: 'Paper', icon: '/images/logos/paper.png', href: `${rel}/connect-spigot.jar`, cta: 'Download for Paper / Spigot', hint: 'Put connect-spigot.jar in plugins/ and restart.', file: true},
  {name: 'Gate', short: 'Gate', icon: '/minekube-logo.png', href: 'https://gate.minekube.com/guide/connect', cta: 'Enable Connect in Gate', hint: 'Gate has Connect built in: no download, just a config switch.', file: false, rec: true},
  {name: 'Velocity', short: 'Velocity', icon: '/images/logos/velocity.png', href: `${rel}/connect-velocity.jar`, cta: 'Download for Velocity', hint: 'Put connect-velocity.jar in plugins/ and restart.', file: true},
  {name: 'BungeeCord', short: 'Bungee', icon: '/images/logos/spigot.png', href: `${rel}/connect-bungee.jar`, cta: 'Download for BungeeCord', hint: 'Put connect-bungee.jar in plugins/ and restart.', file: true},
]

---

<div class="mk-home not-content">
  <!-- ============ Hero ============ -->
  <section class="hero wrap" aria-labelledby="_top">
    <div class="hero-copy">
      <h1 id="_top">Put your Minecraft server online</h1>
      <p class="lead">Minekube Connect gives any server a public address and DDoS protection, even one running on your own PC. No port forwarding, no exposed IP.</p>
      <div class="dl" data-dl>
        <p class="dl-label" id="dl-label">Get Connect for</p>
        <ul class="dl-cards" aria-labelledby="dl-label">
          {downloads.map((d) => (
            <li>
              <a class:list={['dl-card', {rec: d.rec}]} href={d.href} {...(d.file ? {download: ''} : {target: '_blank', rel: 'noreferrer'})} aria-label={d.cta}>
                <img src={d.icon} alt="" width="22" height="22" />
                <span class="nm">{d.name}</span><span class="nm-s" aria-hidden="true">{d.short}</span>
                <span class="dl-ico" set:html={d.file ? `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>` : `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>`} />
              </a>
            </li>
          ))}
        </ul>
        <p class="dl-note">Click your platform to download. <span class="dl-ver"></span> <a href="/guide/quick-start">Setup guide</a></p>
      </div>
    </div>

    <figure class="hero-video">
      <div class="ambient" aria-hidden="true"><img src="https://i.ytimg.com/vi/jcN9Dvt1zLk/mqdefault.jpg" alt="" width="320" height="180" decoding="async" /></div>
      <div class="video-frame">
        <button class="video-play" type="button" data-video="jcN9Dvt1zLk" aria-label="Play video: Self-host a Minecraft server without port forwarding using Minekube Connect">
          <img src="https://i.ytimg.com/vi/jcN9Dvt1zLk/maxresdefault.jpg" alt="" width="1280" height="720" fetchpriority="high" />
          <span class="play" aria-hidden="true"></span>
        </button>
      </div>
      <figcaption>Self-host a Minecraft server without port forwarding. Video by <a href="https://www.youtube.com/@KasaiSora">KasaiSora</a>.</figcaption>
    </figure>
    <a class="scroll-cue" href="#join-title"><span>Scroll down</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
  </section>

  <!-- ============ How players join ============ -->
  <section class="join wrap" aria-labelledby="join-title" data-mode="proxy">
    <div class="sec-head">
      <h2 id="join-title">How a player joins</h2>
      <p>Players type one address. Connect carries them through its nearest edge to your Connector, with or without a proxy in between.</p>
    </div>
    <div class="join-tabs" role="tablist" aria-label="Setup">
      <button role="tab" aria-selected="true" data-mode="proxy">Network with a proxy</button>
      <button role="tab" aria-selected="false" data-mode="smp">Single server (SMP)</button>
    </div>

    <div class="flow" aria-live="polite">
      <ol class="stations">
        <li class="st" data-st="player" data-say="Steve opens Multiplayer and joins yourname.play.minekube.net. No IP address, no port.">
          <span class="st-icon player-head" aria-hidden="true"></span>
          <strong>Player</strong>
          <span class="st-sub">joins <code>yourname.play.minekube.net</code></span>
        </li>
        <li class="st" data-st="edge" data-say="The closest Minekube Connect edge picks up the connection and filters out attacks.">
          <span class="st-icon"><img src="/minekube-logo.png" alt="" width="40" height="40" /></span>
          <strong>Minekube Connect</strong>
          <span class="st-sub">nearest edge, DDoS filtered</span>
        </li>
        <li class="st only-proxy" data-st="proxy" data-say="Connect hands Steve to your Gate or Velocity proxy through the Connector’s tunnel.">
          <span class="st-icon duo"><img src="/minekube-logo.png" alt="" width="28" height="28" /><img src="/images/logos/velocity.png" alt="" width="28" height="28" /></span>
          <strong>Gate or Velocity</strong>
          <span class="st-sub">your proxy, running the Connector</span>
        </li>
        <li class="st only-proxy" data-st="backend" data-say="Your proxy sends Steve to the lobby. Backend servers are never exposed to the internet.">
          <span class="st-icon servers" aria-hidden="true"><i data-srv="0">Lobby</i><i data-srv="1">Survival</i><i data-srv="2">Minigames</i></span>
          <strong>Backend servers</strong>
          <span class="st-sub">behind the proxy, never exposed</span>
        </li>
        <li class="st only-smp" data-st="server" data-say="Connect hands Steve straight to your server through the Connect plugin’s tunnel. Done.">
          <span class="st-icon duo"><img src="/images/logos/paper.png" alt="" width="28" height="28" /><img src="/images/logos/spigot.png" alt="" width="28" height="28" /></span>
          <strong>Your server</strong>
          <span class="st-sub">Paper or Spigot with the Connect plugin</span>
        </li>
      </ol>
      <span class="traveler player-head" aria-hidden="true"></span>
    </div>
    <div class="join-foot">
      <p class="say" aria-live="polite">Steve opens Multiplayer and joins yourname.play.minekube.net. No IP address, no port.</p>
      <p class="chat" aria-hidden="true"><span class="chat-line">Steve joined the game</span></p>
    </div>
    <figure class="console-shot">
      <img src="/images/terminal-log.png" width="2378" height="670" loading="lazy" alt="Server console: the Connect plugin prints the endpoint name live-beru and the public address live-beru.play.minekube.net" />
      <figcaption>What your server console prints once the Connector is running: the address to share with players.</figcaption>
    </figure>
  </section>


  <!-- ============ Works with your setup ============ -->
  <section class="software wrap" aria-labelledby="software-title">
    <div>
      <h2 id="software-title">Works with your setup</h2>
      <p>Paper, Spigot, Velocity and BungeeCord use the Connect plugin. Gate has Connect built in: switch it on in the config and you are done. Every Connector links your server to the same Connect edge.</p>
      <div class="actions">
        <a class="btn primary" href="/guide/connectors/">Choose a Connector</a>
        <a class="btn" href="https://app.minekube.com/">Open dashboard</a>
      </div>
    </div>
    <figure class="hub" aria-label="Minekube Connect links Gate, Velocity, Paper and Spigot servers">
      <svg class="hub-lines" viewBox="0 0 520 440" aria-hidden="true" preserveAspectRatio="none">
        <path id="l-gate" d="M260 176 C 260 262, 72.8 256, 72.8 340" />
        <path id="l-velocity" d="M260 176 C 260 280, 197.6 284, 197.6 384" />
        <path id="l-paper" d="M260 176 C 260 280, 322.4 284, 322.4 384" />
        <path id="l-spigot" d="M260 176 C 260 262, 447.2 256, 447.2 340" />
        <circle r="4" class="pkt"><animateMotion dur="2.6s" repeatCount="indefinite" begin="0s"><mpath href="#l-gate" /></animateMotion></circle>
        <circle r="4" class="pkt"><animateMotion dur="2.6s" repeatCount="indefinite" begin="-1.95s"><mpath href="#l-velocity" /></animateMotion></circle>
        <circle r="4" class="pkt"><animateMotion dur="2.6s" repeatCount="indefinite" begin="-1.3s"><mpath href="#l-paper" /></animateMotion></circle>
        <circle r="4" class="pkt"><animateMotion dur="2.6s" repeatCount="indefinite" begin="-0.65s"><mpath href="#l-spigot" /></animateMotion></circle>
      </svg>
      <a class="hub-core" href="/guide/" aria-label="What is Minekube Connect">
        <img src="/minekube-logo.png" width="507" height="512" alt="" loading="lazy" />
      </a>
      <a class="node high gate" href="/guide/connectors/gate" style="left:14%"><img src="/minekube-logo.png" alt="" width="28" height="28" /><span>Gate</span></a>
      <a class="node low" href="/guide/connectors/plugin" style="left:38%"><img src="/images/logos/velocity.png" alt="" width="28" height="28" /><span>Velocity</span></a>
      <a class="node low" href="/guide/connectors/plugin" style="left:62%"><img src="/images/logos/paper.png" alt="" width="28" height="28" /><span>Paper</span></a>
      <a class="node high" href="/guide/connectors/plugin" style="left:86%"><img src="/images/logos/spigot.png" alt="" width="28" height="28" /><span>Spigot</span></a>
    </figure>
  </section>

  <!-- ============ Use cases ============ -->
  <section class="cases wrap" aria-labelledby="cases-title">
    <div class="sec-head">
      <h2 id="cases-title">What you can do with Connect</h2>
      <p>Pick the situation that sounds like yours. Each one links to the guide that sets it up.</p>
    </div>
    <ul class="case-grid">
      {cases.map((c) => (
        <li>
          <a href={c.link}>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <span class="case-go">{c.linkText}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ Browser Hub ============ -->
  <section class="discover wrap" aria-labelledby="discover-title">
    <figure>
      <img src="/images/browser-hub.png" width="3840" height="2214" loading="lazy" alt="The Browser Hub in Minecraft: a lobby with the banner ‘Browse localhost & public servers!’ and links to the website, the download and Discord" />
    </figure>
    <div>
      <h2 id="discover-title">Get discovered</h2>
      <p>Players browse servers in the Browser Hub. Anyone who joins <strong>minekube.net</strong>, or types <code>/browser</code> on a connected server, lands in one lobby that lists localhost and public servers side by side.</p>
      <p>Listing is free and favours new and smaller servers, so a fresh SMP gets seen too.</p>
      <a class="more" href="/guide/advertising">How advertising works</a>
    </div>
  </section>


  <!-- ============ Testimonials ============ -->
  <section class="words wrap" aria-labelledby="words-title">
    <div class="sec-head">
      <h2 id="words-title">What the community says</h2>
      <p>Server owners and developers who build with Minekube and Gate.</p>
    </div>
    <div class="quotes">
      {testimonials.map((t) => (
        <figure>
          <blockquote><p>“{t.body}”</p></blockquote>
          <figcaption>
            {t.avatar ? <img src={t.avatar} alt="" width="40" height="40" loading="lazy" /> : <span class="ph" aria-hidden="true">{t.name[0]}</span>}
            <span class="who"><strong>{t.name}</strong>{t.handle && <span>@{t.handle}</span>}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>


  <!-- ============ Roadmap ============ -->
  <section class="platform wrap" aria-labelledby="platform-title">
    <div class="sec-head">
      <h2 id="platform-title">Where Minekube is heading</h2>
      <p>Connect runs our open source Gate proxy as an edge network for Minecraft. It is the first product; these are next.</p>
    </div>
    <ul class="products">
      {products.map((p) => (
        <li class:list={{live: !p.soon}}>
          <span class="status">{p.soon ? 'Coming soon' : 'Live now'}</span>
          <h3>{p.name.replace('Minekube ', '')}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ul>
    <div class="cf">
      <div class="cf-head">
        <h3>Edge networking, made for Minecraft</h3>
        <p>General-purpose CDNs don’t carry Minecraft connections for free. Connect does, with Gate deployed at every edge.</p>
      </div>
      <dl>
        {capabilities.map((c) => (
          <div><dt>{c.name}</dt><dd>{c.text}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ============ Team ============ -->
  <section class="mission wrap" aria-labelledby="mission-title">
    <div class="sec-head">
      <h2 id="mission-title">Meet the team</h2>
      <p>An international group of contributors and a dedicated core team build Minekube’s open source projects and services.</p>
    </div>
    <Team showLead={false} />
  </section>

  <!-- ============ Call to action ============ -->
  <section class="final wrap" aria-labelledby="final-title">
    <h2 id="final-title">Put your server online today</h2>
    <p>Free for everyone. One plugin, one restart, one address to share.</p>
    <div class="actions">
      <a class="btn primary" href="#_top">Get Connect</a>
      <a class="btn" href="/guide/quick-start">Read the Quick Start</a>
    </div>
  </section>
</div>

<script>
  const root = document.querySelector('.mk-home')!
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

  // ---- Player join animation ----
  const join = root.querySelector<HTMLElement>('.join')!
  const flow = join.querySelector<HTMLElement>('.flow')!
  const traveler = join.querySelector<HTMLElement>('.traveler')!
  const chat = join.querySelector<HTMLElement>('.chat')!
  const say = join.querySelector<HTMLElement>('.say')!
  let timer = 0
  let step = 0

  const stationsFor = () =>
    [...join.querySelectorAll<HTMLElement>('.st')].filter((el) => getComputedStyle(el).display !== 'none')

  const place = (el: HTMLElement) => {
    const icon = el.querySelector<HTMLElement>('.st-icon')!
    const f = flow.getBoundingClientRect()
    const r = icon.getBoundingClientRect()
    // the marker hops along on top of each station's icon
    traveler.style.transform = `translate(${r.left - f.left + r.width / 2}px, ${r.top - f.top - 6}px) translate(-50%, -100%)`
  }

  const tick = () => {
    const list = stationsFor()
    if (step >= list.length) step = 0
    const last = step === list.length - 1
    // jump back to the player without sliding across the whole flow
    traveler.style.transition = step === 0 ? 'none' : ''
    place(list[step])
    void traveler.offsetWidth
    traveler.style.transition = ''
    list.forEach((el, i) => el.toggleAttribute('data-lit', i <= step))
    list.forEach((el, i) => el.toggleAttribute('data-here', i === step))
    join.querySelectorAll<HTMLElement>('[data-srv]').forEach((s) => s.toggleAttribute('data-on', last && s.dataset.srv === '0'))
    chat.toggleAttribute('data-show', last)
    say.textContent = list[step].dataset.say ?? ''
    step++
    timer = window.setTimeout(tick, last ? 2800 : 1100)
  }

  const start = () => {
    clearTimeout(timer)
    step = 0
    if (reduce) {
      const list = stationsFor()
      list.forEach((el) => el.setAttribute('data-lit', ''))
      chat.setAttribute('data-show', '')
      traveler.hidden = true
      return
    }
    tick()
  }

  join.querySelectorAll<HTMLButtonElement>('[role=tab]').forEach((tab) =>
    tab.addEventListener('click', () => {
      join.dataset.mode = tab.dataset.mode
      join.querySelectorAll('[role=tab]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)))
      start()
    }))

  new IntersectionObserver((e) => { if (e[0].isIntersecting) { start(); } else clearTimeout(timer) }, {threshold: 0.3}).observe(join)
  addEventListener('resize', () => { const list = stationsFor(); const here = list.findIndex((el) => el.hasAttribute('data-here')); if (here >= 0) place(list[here]) })

  // ---- Hero downloads: latest version label ----
  const dl = root.querySelector<HTMLElement>('[data-dl]')!
  fetch('https://api.github.com/repos/minekube/connect-java/releases/latest')
    .then((r) => (r.ok ? r.json() : null))
    .then((j) => { if (j?.tag_name) dl.querySelector('.dl-ver')!.textContent = `Latest: v${String(j.tag_name).replace(/^v/, '')}` })
    .catch(() => {})

  // ---- Scroll cue disappears once the visitor scrolls ----
  const cue = root.querySelector<HTMLElement>('.scroll-cue')
  if (cue) {
    const onScroll = () => cue.classList.toggle('gone', scrollY > 40)
    addEventListener('scroll', onScroll, {passive: true})
    onScroll()
  }

  // ---- Click-to-play video ----
  const play = root.querySelector<HTMLButtonElement>('.video-play')!
  play.addEventListener('click', () => {
    const f = document.createElement('iframe')
    f.src = `https://www.youtube-nocookie.com/embed/${play.dataset.video}?rel=0&modestbranding=1&playsinline=1&autoplay=1&mute=1`
    f.title = 'Minekube Connect video'
    f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
    f.allowFullscreen = true
    play.replaceWith(f)
    play.closest('.hero-video')?.classList.add('playing')
  })

  // ---- Entrances ----
  if (!reduce) {
    root.classList.add('js')
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target) }
    }), {threshold: 0.12})
    root.querySelectorAll('section').forEach((s) => io.observe(s))
  }
</script>

<style is:global>
  .content-panel:has(.mk-home) { padding: 0 !important; border: 0; }
  :root:not([data-has-sidebar]) .content-panel:has(.mk-home) .sl-container { max-width: none !important; margin: 0; padding-inline: 0; }
  :root:not([data-has-sidebar]) .content-panel:has(.mk-home) { padding-top: 0 !important; }
  .content-panel:has(.mk-home) .sl-markdown-content { margin: 0; }
  /* The team list sits inside the home page here, without its own top margin. */
  .mk-home .mk-team { margin-top: 0; }
</style>

<style>
  .mk-home {
    --ground: var(--sl-color-black);
    --ink: var(--sl-color-white);
    --soft: var(--sl-color-gray-2);
    --muted: var(--sl-color-gray-3);
    --field: var(--sl-color-gray-6);
    --field-2: var(--sl-color-gray-5);
    --accent: var(--mk-orange);
    --m: clamp(1.25rem, 4vw, 3rem);
    --gap: clamp(5rem, 9vw, 8rem);
    color: var(--ink);
    font-size: 1.0625rem;
    line-height: 1.55;
    padding-bottom: var(--gap);
  }
  .mk-home :where(h1, h2, h3, p, ul, ol, dl, dd, figure, blockquote) { margin: 0; }
  .mk-home :where(a) { color: inherit; }
  .wrap { max-width: var(--mk-page-width); margin-inline: auto; padding-inline: var(--mk-gutter); box-sizing: border-box; }
  .mk-home section + section { margin-top: var(--gap); }
  .mk-home h2 {
    font-family: var(--mk-display); font-weight: 750; font-stretch: 82%;
    font-size: clamp(2rem, 1.3rem + 2.2vw, 3.25rem); line-height: 1.02; letter-spacing: -0.02em; color: var(--ink);
  }
  .mk-home h3 { font-size: 1.1875rem; font-weight: 700; line-height: 1.3; color: var(--ink); }
  .mk-home code { font-family: var(--sl-font-mono); font-size: 0.88em; background: var(--field); padding: 0.1em 0.35em; border-radius: 0.25rem; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 2.875rem; padding: 0 1.25rem;
    font-weight: 650; font-size: 1rem; text-decoration: none; border-radius: 999px;
    background: var(--field); color: var(--ink); transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .btn:hover { background: var(--field-2); transform: translateY(-1px); }
  .btn.primary { background: var(--accent); color: #160a01; }
  .btn.primary:hover { background: #ff9440; }
  .btn:focus-visible, .mk-home a:focus-visible, .mk-home button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  /* ---------------- hero ---------------- */
  .hero {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 5rem); align-items: center;
    min-height: calc(100svh - var(--sl-nav-height)); padding-block: 3rem 5rem; box-sizing: border-box;
  }
  .scroll-cue {
    position: absolute; left: 50%; bottom: 1.5rem; transform: translateX(-50%);
    display: grid; justify-items: center; gap: 0.35rem; color: var(--muted); font-size: 0.875rem; font-weight: 600; text-decoration: none;
    transition: color 0.15s ease;
  }
  .scroll-cue:hover { color: var(--ink); }
  .mk-home .hero .scroll-cue { transition: opacity 0.35s ease, transform 0.35s ease, color 0.15s ease !important; }
  .mk-home .hero .scroll-cue.gone { opacity: 0 !important; transform: translate(-50%, 10px) !important; pointer-events: none; }
  .scroll-cue svg { width: 1.5rem; height: 1.5rem; }
  @keyframes nudge { 50% { transform: translateY(4px); } }
  .hero-copy { min-width: 0; }
  .dl { margin-top: 2rem; max-width: 100%; min-width: 0; }
  .dl-label { font-size: 0.9375rem; font-weight: 600; color: var(--muted); margin: 0 0 0.6rem !important; }
  .dl-cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; max-width: 30rem; }
  .dl-card {
    display: flex; align-items: center; gap: 0.55rem; padding: 0.6rem 0.6rem 0.6rem 0.9rem; border-radius: 999px; box-sizing: border-box;
    background: var(--field); color: var(--ink); text-decoration: none; font-weight: 650; font-size: 0.9375rem; white-space: nowrap;
    transition: background-color 0.2s ease, transform 0.2s cubic-bezier(.3,.7,.2,1), box-shadow 0.2s ease;
  }
  .dl-card img { width: 1.35rem; height: 1.35rem; object-fit: contain; border-radius: 0.3rem; }
  .dl-card .nm, .dl-card .nm-s { margin-right: auto; }
  .dl-ico { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 999px; background: var(--field-2); color: var(--soft); transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease; }
  .dl-ico :global(svg) { width: 0.95rem; height: 0.95rem; }
  .dl-card:hover { background: var(--field-2); transform: translateY(-2px); }
  .dl-card:hover .dl-ico { background: var(--accent); color: #160a01; transform: translateY(1px); }
  .dl-card:active { transform: translateY(0); }
  .dl-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .dl-card.rec { background: color-mix(in srgb, var(--accent) 14%, var(--field)); box-shadow: inset 0 0 0 1.5px var(--accent); color: var(--accent); }
  .dl-card.rec .dl-ico { background: var(--accent); color: #160a01; }
  .dl-card.rec:hover { background: color-mix(in srgb, var(--accent) 22%, var(--field)); }
  .nm-s { display: none; }
  @media (max-width: 30rem) {
    .dl-card { font-size: 0.875rem; padding-left: 0.75rem; }
    .dl-card .nm { display: none; }
    .dl-card .nm-s { display: inline; margin-right: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ambient img { animation: none; } .dl-card, .dl-ico { transition: none; } }
  .dl-note { margin-top: 0.9rem !important; font-size: 0.9375rem; color: var(--muted); }
  .dl-note a { color: var(--ink); font-weight: 650; margin-left: 0.35rem; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.2em; }
  .dl-ver { margin-left: 0.35rem; color: var(--soft); font-weight: 600; }
  .addr { display: grid; gap: 0.5rem; margin-top: 2rem; max-width: 30rem; }
  .addr-label { font-size: 0.9375rem; font-weight: 600; color: var(--muted); }
  .addr-box { display: flex; align-items: center; background: var(--field); border-radius: 0.6rem; padding: 0.8rem 1rem; font-family: var(--sl-font-mono); font-size: 1.0625rem; cursor: text; }
  .addr-box:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .addr-box input { all: unset; color: var(--accent); font-weight: 600; width: 8ch; }
  .addr-domain { color: var(--ink); white-space: nowrap; }
  .hero h1 {
    font-family: var(--mk-display); font-weight: 800; font-stretch: 80%;
    font-size: clamp(2.75rem, 1.4rem + 4vw, 5rem); line-height: 0.98; letter-spacing: -0.03em; color: var(--ink); max-width: 14ch;
  }
  .hero-sub-unused { margin-top: 0.4rem !important; font-family: var(--mk-display); font-weight: 750; font-stretch: 82%; font-size: clamp(1.75rem, 1.2rem + 1.7vw, 2.75rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--ink); max-width: 18ch; }
  .lead { margin-top: 1.5rem !important; font-size: clamp(1.125rem, 1rem + 0.4vw, 1.3rem); line-height: 1.5; color: var(--soft); max-width: 34rem; }
  .tag { margin-top: 0.75rem !important; font-weight: 600; }
  .tag a { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.25em; }
  .tag a:hover { color: var(--accent); }

  .hub { position: relative; aspect-ratio: 520 / 440; width: 100%; max-width: 38rem; justify-self: end; }
  .hub::before {
    content: ''; position: absolute; left: 50%; top: 22%; width: 60%; aspect-ratio: 1; transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgb(243 128 32 / 0.16), transparent); pointer-events: none;
  }
  .hub-lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .hub-lines path { fill: none; stroke: var(--sl-color-gray-4); stroke-width: 1.6; stroke-dasharray: 5 7; vector-effect: non-scaling-stroke; animation: flow 1.6s linear infinite; }
  .pkt { fill: var(--accent); }
  @keyframes flow { to { stroke-dashoffset: -24; } }
  .hub-core { position: absolute; left: 50%; top: 20%; width: 34%; transform: translate(-50%, -50%); display: block; animation: float 6s ease-in-out infinite; }
  .hub-core img { width: 100%; height: auto; display: block; transition: transform 0.3s ease; }
  .hub-core:hover img { transform: scale(1.04); }
  @keyframes float { 50% { transform: translate(-50%, calc(-50% - 8px)); } }
  .node {
    position: absolute; top: 80%; width: 22%; box-sizing: border-box; transform: translate(-50%, 0);
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.55rem 0.5rem; border-radius: 999px; background: var(--field); color: var(--ink);
    font-weight: 650; font-size: 0.9375rem; text-decoration: none; white-space: nowrap;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .node img { width: 28px; height: 28px; object-fit: contain; border-radius: 0.3rem; }
  .node.high { top: 77.3%; }
  .node.low { top: 87.3%; }
  .node.gate { background: color-mix(in srgb, var(--accent) 16%, var(--field)); box-shadow: inset 0 0 0 1.5px var(--accent); color: var(--ink); }
  .node.gate:hover { background: color-mix(in srgb, var(--accent) 26%, var(--field)); }
  .node:hover { background: var(--field-2); transform: translate(-50%, -2px); }

  /* ---------------- join flow ---------------- */
  .join-tabs { display: inline-flex; gap: 0.25rem; padding: 0.3rem; margin-top: 3rem; background: var(--field); border-radius: 999px; }
  .join-tabs button {
    all: unset; cursor: pointer; padding: 0.55rem 1.1rem; border-radius: 999px; font-weight: 650; font-size: 0.9375rem; color: var(--muted);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .join-tabs button[aria-selected='true'] { background: var(--field-2); color: var(--ink); }
  .flow { position: relative; margin-top: 2rem; padding: clamp(1.75rem, 4vw, 3rem) clamp(1rem, 3vw, 2.5rem); background: var(--field); border-radius: 1rem; }
  .stations { list-style: none; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 1rem; position: relative; }
  .st { display: grid; justify-items: center; text-align: center; gap: 0.4rem; position: relative; z-index: 1; }
  .st + .st::before {
    content: ''; position: absolute; z-index: -1; top: 2rem; right: calc(50% + 2.4rem); width: calc(100% - 4.8rem + 1rem); height: 2px;
    background: repeating-linear-gradient(90deg, var(--sl-color-gray-4) 0 6px, transparent 6px 12px);
  }
  .st[data-lit]::before { background: var(--accent) !important; }
  .st-icon {
    width: 4rem; height: 4rem; display: grid; place-items: center; border-radius: 0.9rem; background: var(--ground);
    transition: background-color 0.3s ease, transform 0.3s ease;
  }
  .st-icon img { width: 2.5rem; height: 2.5rem; object-fit: contain; }
  .st-icon.duo { display: flex; gap: 0.2rem; justify-content: center; align-items: center; }
  .st-icon.duo img { width: 1.6rem; height: 1.6rem; }
  .st[data-lit] .st-icon:not(.player-head) { background: color-mix(in srgb, var(--accent) 24%, var(--ground)); }
  .st[data-here] .st-icon { transform: translateY(-3px); }
  .st strong { margin-top: 0.4rem; font-size: 1.0625rem; }
  .st-sub { color: var(--muted); font-size: 0.9375rem; line-height: 1.4; max-width: 15rem; }
  .st-sub code { font-size: 0.82em; }
  .servers { width: auto; min-width: 4rem; padding: 0.35rem; display: grid; gap: 0.2rem; height: auto; }
  .servers i { font-style: normal; font-size: 0.75rem; font-weight: 650; padding: 0.1rem 0.5rem; border-radius: 0.3rem; background: var(--field); color: var(--muted); transition: background-color 0.3s ease, color 0.3s ease; }
  .servers i[data-on] { background: var(--accent); color: #160a01; }
  .player-head {
    width: 2.5rem; height: 2.5rem; image-rendering: pixelated; border-radius: 0.2rem;
    background:
      linear-gradient(#3b2a1e 0 0) 0 0 / 100% 30% no-repeat,
      linear-gradient(#fff 0 0) 20% 55% / 12.5% 12.5% no-repeat,
      linear-gradient(#3953a4 0 0) 32.5% 55% / 12.5% 12.5% no-repeat,
      linear-gradient(#3953a4 0 0) 67.5% 55% / 12.5% 12.5% no-repeat,
      linear-gradient(#fff 0 0) 80% 55% / 12.5% 12.5% no-repeat,
      linear-gradient(#6b3f2a 0 0) 50% 82% / 37.5% 12.5% no-repeat,
      #c8946a;
  }
  .st-icon.player-head { width: 4rem; height: 4rem; border-radius: 0.9rem; }
  .traveler {
    position: absolute; left: 0; top: 0; width: 1.4rem; height: 1.4rem; z-index: 2; pointer-events: none;
    transition: transform 0.9s cubic-bezier(.6,0,.3,1);
  }
  .join-foot { margin-top: 1.25rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; min-height: 2.5rem; }
  .say { flex: 1 1 auto; min-width: 0; font-size: 1.0625rem; font-weight: 550; color: var(--ink); min-height: 1.8em; display: flex; align-items: center; }
  .chat { flex: none; }
  .chat-line {
    display: inline-block; padding: 0.35rem 0.75rem; border-radius: 0.35rem; background: rgb(0 0 0 / 0.55); color: #ffff55;
    font-family: var(--sl-font-mono); font-size: 0.9375rem; opacity: 0; transform: translateY(6px); transition: opacity 0.3s ease, transform 0.3s ease;
  }
  :root[data-theme='light'] .chat-line { background: #1d1d20; }
  .chat[data-show] .chat-line { opacity: 1; transform: none; }
  .join-note { margin-top: 1rem !important; color: var(--soft); min-height: 3.2em; }
  .join-note a { font-weight: 650; text-decoration-color: var(--accent); text-underline-offset: 0.2em; }
  .join[data-mode='proxy'] .only-smp, .join[data-mode='smp'] .only-proxy { display: none; }
  .stations { min-height: 11rem; align-items: start; }


  .console-shot { margin-top: 1.5rem; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 1.5rem; align-items: center; }
  .console-shot img { width: 100%; height: auto; display: block; border-radius: 0.75rem; }
  .console-shot figcaption { color: var(--soft); }

  /* ---------------- discover ---------------- */
  .discover { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .discover img { width: 100%; height: auto; display: block; border-radius: 1rem; }
  .discover p { margin-top: 1.25rem !important; color: var(--soft); font-size: 1.125rem; }
  .discover strong { color: var(--ink); }
  .more { display: inline-block; margin-top: 1.25rem; font-weight: 650; color: var(--accent); text-decoration: none; transition: color 0.2s ease; }
  .more::after { content: ' →'; }
  .more:hover { color: var(--ink) !important; }

  /* ---------------- hero video ---------------- */
  .hero-video { position: relative; isolation: isolate; margin: 0; justify-self: end; width: 100%; max-width: 40rem; }
  .hero-video .video-frame { position: relative; margin-top: 0; border-radius: 1.25rem; box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.55); }
  /* Ambient light: a blurred copy of the thumbnail glows behind the player and breathes slowly. */
  .ambient { position: absolute; z-index: -1; left: -4%; right: -4%; top: -6%; aspect-ratio: 16 / 9; pointer-events: none; }
  .ambient img {
    width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 1.25rem;
    filter: blur(56px) saturate(1.6); opacity: 0.6; transform: scale(1.06); will-change: transform, opacity;
    animation: ambient 7s ease-in-out infinite alternate;
  }
  .hero-video.playing .ambient img { opacity: 0.7; }
  @keyframes ambient { from { transform: scale(1.02); opacity: 0.5; } to { transform: scale(1.12); opacity: 0.75; } }
  :root[data-theme='light'] .ambient img { opacity: 0.35; }
  .hero-video figcaption { margin-top: 0.85rem; color: var(--muted); font-size: 0.9375rem; }
  .hero-video figcaption a { color: var(--soft); font-weight: 600; text-decoration-color: var(--accent); text-underline-offset: 0.2em; }

  /* ---------------- section heads ---------------- */
  /* Section heading: title on one line at the left, its description on the right, centred against it. */
  .sec-head { display: grid; grid-template-columns: auto minmax(16rem, 30rem); justify-content: space-between; align-items: center; gap: 1.25rem clamp(2.5rem, 6vw, 6rem); }
  .sec-head h2 { white-space: nowrap; }
  .mk-home .sec-head + * { margin-top: 3rem !important; }
  .sec-head p { color: var(--soft); font-size: 1.0625rem; line-height: 1.6; text-align: left; }
  @media (max-width: 72rem) { .sec-head h2 { white-space: normal; } }

  /* ---------------- use cases ---------------- */
  .case-grid { list-style: none; padding: 0; margin-top: 3rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .case-grid a {
    display: flex; flex-direction: column; gap: 0.7rem; height: 100%; box-sizing: border-box; padding: 1.75rem; border-radius: 1.25rem;
    background: var(--field); text-decoration: none; transition: background-color 0.18s ease, transform 0.18s ease;
  }
  .case-grid a:hover { background: var(--field-2); transform: translateY(-2px); }
  .case-grid h3 { font-size: 1.1875rem; color: var(--accent) !important; }
  .case-grid p { color: var(--soft); flex: 1; line-height: 1.65; }
  .case-go { margin-top: 0.5rem; font-weight: 650; color: var(--accent); transition: color 0.2s ease; }
  .case-grid a:hover .case-go { color: var(--ink); }
  .case-go::after { content: ' →'; }

  /* ---------------- closing call to action ---------------- */
  .final { text-align: center; display: grid; justify-items: center; gap: 1rem; padding-block: clamp(3rem, 6vw, 5rem); border-radius: 1.5rem;
    background: color-mix(in srgb, var(--accent) 9%, var(--field)); max-width: calc(var(--mk-page-width) - 2 * var(--mk-gutter)); }
  .final p { color: var(--soft); font-size: 1.125rem; }
  .final .actions { justify-content: center; margin-top: 0.75rem; }

  /* ---------------- video ---------------- */
  .video-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; align-items: end; }
  .video-head p { color: var(--soft); }
  .video-frame { margin-top: 2.5rem; aspect-ratio: 16 / 9; border-radius: 1rem; overflow: hidden; background: var(--field); }
  .video-frame :global(iframe), .video-play { width: 100%; height: 100%; border: 0; display: block; }
  .video-play { all: unset; cursor: pointer; position: relative; display: block; width: 100%; height: 100%; }
  .video-play img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
  .video-play:hover img { transform: scale(1.02); }
  .play { position: absolute; left: 50%; top: 50%; width: 5rem; height: 5rem; transform: translate(-50%, -50%); border-radius: 50%; background: var(--accent); transition: transform 0.2s ease; }
  .play::after { content: ''; position: absolute; left: 54%; top: 50%; transform: translate(-50%, -50%); border-style: solid; border-width: 0.8rem 0 0.8rem 1.3rem; border-color: transparent transparent transparent #160a01; }
  .video-play:hover .play { transform: translate(-50%, -50%) scale(1.06); }

  /* ---------------- platform ---------------- */
  .products { list-style: none; padding: 0; margin-top: 3rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .products li { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.75rem; border-radius: 1.25rem; background: var(--field); }
  .products li.live { background: color-mix(in srgb, var(--accent) 10%, var(--field)); box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--accent) 60%, transparent); }
  .status { align-self: flex-start; font-size: 0.8125rem; font-weight: 650; padding: 0.25rem 0.65rem; border-radius: 999px; background: var(--field-2); color: var(--soft); }
  .live .status { background: var(--accent); color: #160a01; }
  .products h3 { font-size: 1.25rem; }
  .products p { color: var(--soft); line-height: 1.6; }
  .cf { margin-top: 1.25rem; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 2rem clamp(2rem, 5vw, 5rem); align-items: center; padding: clamp(1.75rem, 4vw, 2.5rem); background: var(--field); border-radius: 1.25rem; }
  .cf-head h3 { font-size: 1.375rem; line-height: 1.25; }
  .cf-head p { margin-top: 0.6rem !important; color: var(--soft); line-height: 1.6; }
  .cf dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; margin: 0; }
  .cf dt { font-weight: 700; color: var(--ink); }
  .cf dd { margin: 0.35rem 0 0; color: var(--soft); line-height: 1.6; }

  /* ---------------- testimonials ---------------- */
  .quotes { margin-top: 3rem; columns: 3 18rem; column-gap: 1.25rem; }
  .quotes figure { break-inside: avoid; margin: 0 0 1.25rem; padding: 1.4rem 1.5rem; background: var(--field); border-radius: 0.9rem; }
  .quotes blockquote { border: 0; padding: 0; }
  .quotes blockquote p { font-size: 1rem; line-height: 1.55; color: var(--ink); }
  .quotes figcaption { margin-top: 1.1rem; display: flex; align-items: center; gap: 0.75rem; font-size: 0.9375rem; }
  .quotes figcaption img, .quotes .ph { width: 2.5rem; height: 2.5rem; border-radius: 50%; object-fit: cover; flex: none; background: var(--field-2); }
  .quotes .ph { display: grid; place-items: center; font-weight: 700; color: var(--soft); }
  .quotes .who { display: grid; }
  .quotes .who span { color: var(--muted); }

  /* ---------------- software ---------------- */
  .software { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem clamp(2rem, 5vw, 5rem); align-items: center; }
  .software p { margin-top: 1.25rem !important; color: var(--soft); font-size: 1.125rem; }

  .mission .sec-head { margin-bottom: 3rem; }

  /* ---------------- motion ---------------- */
  @media (prefers-reduced-motion: no-preference) {
    .js section:not(.hero) > * { opacity: 0; transform: translateY(20px); transition: opacity 0.7s cubic-bezier(.2,.7,.2,1), transform 0.7s cubic-bezier(.2,.7,.2,1); }
    .js section > :nth-child(2) { transition-delay: 80ms; }
    .js section > :nth-child(3) { transition-delay: 160ms; }
    .js section > :nth-child(n+4) { transition-delay: 240ms; }
    .js section.in > * { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hub-lines path, .hub-core { animation: none; }
    .pkt { display: none; }
  }

  /* ---------------- tablet / phone ---------------- */
  @media (max-width: 56rem) {
    .hero, .video-head, .software, .cf, .discover, .console-shot, .sec-head { grid-template-columns: 1fr; }
    .case-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-video { justify-self: stretch; max-width: none; }
    .hero { min-height: auto; padding-bottom: 2rem; }
    .scroll-cue { display: none; }
    .hub { max-width: 30rem; }
    .cf dl { grid-template-columns: 1fr; }
    .products { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .features ul { grid-template-columns: 1fr; }
  }
