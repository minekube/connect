  .row { display: flex; align-items: center; gap: 0.55rem; padding: 0.45rem 0.55rem; border-radius: 0.5rem; font-family: var(--sl-font-mono); font-size: 0.8125rem; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row.dim { color: var(--muted); }
  .fi { display: inline-grid; flex: none; }
  .fi :global(svg) { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .jar-src { background: color-mix(in srgb, var(--accent) 16%, transparent); position: relative; z-index: 1; }
  .jar-dst { opacity: 0; background: color-mix(in srgb, var(--accent) 16%, transparent); }
  .how.run[data-step='0'] .jar-src { animation: jar-move 5.2s cubic-bezier(.6,0,.25,1) both; }
  .how.run[data-step='0'] .jar-dst { animation: jar-land 5.2s ease both; }
  @keyframes jar-move {
    0%, 22% { transform: none; opacity: 1; box-shadow: none; }
    30% { transform: translateY(-4px) scale(1.03); box-shadow: 0 10px 24px rgb(0 0 0 / 0.35); }
    58% { transform: translate(var(--dx, 0), var(--dy, 0)) scale(1.03); opacity: 1; box-shadow: 0 10px 24px rgb(0 0 0 / 0.35); }
    64%, 100% { transform: translate(var(--dx, 0), var(--dy, 0)); opacity: 0; }
  }
  @keyframes jar-land { 0%, 60% { opacity: 0; } 66%, 100% { opacity: 1; } }

