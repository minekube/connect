---
import Team from './Team.astro'
import {discordLink} from '../shared'
// Partner logos are inlined as exported from each partner's site.
import akuaLogo from '../assets/trusted/akua.svg?raw'

// Home page: each section answers one question for a visitor, in this order:
// what is it (hero + video), what can I do with it, how does it work, does it fit my setup, where do players find me, who uses it, who builds it. The roadmap lives on /guide/roadmap.
// Feature icons: outlines from Lucide (ISC licence, lucide.dev).
const icons: Record<string, string> = {
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  tunnel: '<path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/>',
  home: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  network: '<rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/>',
  phone: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/>',
  package: '<path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 7.703 4.734a2 2 0 0 0 1.994 0L20.7 7"/><path d="m7.5 4.27 9 5.15"/>',
  dashboard: '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
}

// What you can do with Connect: one card per feature, right under the hero, each linking its guide.
const features = [
  {icon: 'shield', title: 'Keep attacks away', text: 'Your real IP stays hidden and floods stop at the edge.', link: '/guide/protections'},
  {icon: 'home', title: 'Host from your own PC', text: 'Friends join NAME.play.minekube.net. No port forwarding.', link: '/guide/localhost'},
  {icon: 'globe', title: 'Free or custom domain', text: 'A free play.minekube.net address, or your own domain.', link: '/guide/domains'},
  {icon: 'phone', title: 'Java and Bedrock', text: 'Bedrock players join on the same address.', link: '/guide/bedrock'},
  {icon: 'network', title: 'Run a whole network', text: 'Gate or Velocity in front, one address for every server.', link: '/guide/topologies'},
  {icon: 'tunnel', title: 'Connect Tunnels', text: 'Players reach your server without open ports.', link: '/guide/tunnels'},
  {icon: 'package', title: 'Quick installation', text: 'One plugin or a Gate config switch.', link: '/guide/quick-start'},
  {icon: 'dashboard', title: 'One dashboard', text: 'Endpoints, connectors, domains and stats together.', link: 'https://app.minekube.com'},
]

const testimonials = [
  {body: 'Hey, just wanted to reach out and say hi really! Your Minekube project caught our attention, and it’s great to connect with others doing cool stuff in the Minecraft tech space. Would love to have a call to introduce ourselves and hear about your story, plus trade stories of working with Minecraft in weird and wonderful ways', name: 'Zed - Managing Director', handle: 'cubecraft', avatar: '/images/avatars/zed.png'},
  {body: 'It is extremely interesting to see Minekube evolve', name: 'Joshua - CTO', handle: 'justchunks', avatar: '/images/avatars/joshua.png'},
  {body: 'Gradients in Gate. Added arguments to my NBS command, so I’m just jamming right now. Lol, it even supports server switching mid-song, which I assume wasn’t done before. However, Gate has revived my love for Go lol. The SimpleProxy is surprisingly good at covering all bases like scheduling, messages, Brigadier (plus suggestions), and events.', name: 'emortal', handle: 'emortalmc', avatar: '/images/avatars/emortal.png'},
  {body: 'It looks lovely! I have had a good time working on my project so far with Gate and am excited to see its progress.', name: 'Ö for{i}am꧂', handle: 'bgp179', avatar: '/images/avatars/foriam.webp'},
  {body: 'I’m working on a cloud system in Go and want to support Gate to enhance user experience and make it more extendable. Here’s the current version of the Go MC cloud system with a dashboard in action.', name: 'Cerberus - Founder PricelessKeys', handle: 'cerberus.labs', avatar: '/images/avatars/cerberus.webp'},
  {body: 'Thank you, I didn’t realize how braindead proxy protocol was, ended up using that. To those looking at a similar situation: it’s literally just ‘proxyprotocol: true’ in paper globals. Enable that on Gate and bada bing bada boom, you’re golden.', name: 'Server User'},
  {body: 'The instructions for the setup are clear and easy to understand. Both setups I tested are working perfectly, with Gate Lite routing the connection correctly. The custom domain feature is great and works perfectly. I appreciate the ability to manually trigger a refresh for the DNS-check.', name: 'NixNux123 - Admin', handle: 'FynnCraft', avatar: '/images/avatars/nixnux.png'},
  {body: 'I like this project so much, I would even be happy to host my own gateway and allow others to use it. I’m sure that people will eventually find Minekube.', name: 'Akos', handle: 'theforgtn', avatar: '/images/avatars/akos.png'},
  {body: 'Thanks for making some cool software Minekube', name: 'Dylan', handle: 'dilllxd', avatar: '/images/avatars/dylan.png'},
]

// How it works: per platform, where the Connector goes and what the console prints.
const addr = 'live-beru.play.minekube.net'
const platforms = {
  paper: {
    label: 'Paper / Spigot', icon: '/images/logos/paper.png', folder: 'my-server', jar: 'connect-spigot.jar', others: ['LuckPerms.jar', 'EssentialsX.jar'],
    add: 'Download connect-spigot.jar and drop it into your server’s plugins folder.',
    log: [['Server', 'Starting Minecraft server on *:25565'], ['Server', 'Loading plugins'], ['connect', 'Enabling connect'], ['connect', 'Endpoint name: live-beru'], ['connect', `Your public address: ${addr}`, 1], ['Server', 'Done (3.1s)! For help, type "help"']],
  },
  velocity: {
    label: 'Velocity', icon: '/images/logos/velocity.png', folder: 'my-proxy', jar: 'connect-velocity.jar', others: ['LuckPerms.jar'],
    add: 'Download connect-velocity.jar and drop it into the proxy’s plugins folder.',
    log: [['velocity', 'Booting up Velocity'], ['velocity', 'Loaded plugin connect'], ['connect', 'Endpoint name: live-beru'], ['connect', `Your public address: ${addr}`, 1], ['velocity', 'Listening on /0.0.0.0:25577']],
  },
  bungee: {
    label: 'BungeeCord', icon: '/images/logos/spigot.png', folder: 'my-proxy', jar: 'connect-bungee.jar', others: ['LuckPerms.jar'],
    add: 'Download connect-bungee.jar and drop it into the proxy’s plugins folder.',
    log: [['bungee', 'Enabled BungeeCord'], ['bungee', 'Loaded plugin connect'], ['connect', 'Endpoint name: live-beru'], ['connect', `Your public address: ${addr}`, 1], ['bungee', 'Listening on /0.0.0.0:25577']],
  },
  gate: {
    label: 'Gate', icon: '/minekube-logo.png', folder: 'gate', jar: '', others: [],
    add: 'Gate has Connect built in. Switch it on in config.yml, no download needed.',
    log: [['gate', 'Starting Gate proxy'], ['connect', 'Connect enabled'], ['connect', 'Endpoint name: live-beru'], ['connect', `Public address: ${addr}`, 1], ['gate', 'Listening on 0.0.0.0:25565']],
  },
} as const
type Pf = keyof typeof platforms
const pfKeys = Object.keys(platforms) as Pf[]
const fileIco = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>'
const folderIco = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>'

// Trusted by: logos shown greyed out until hovered.
const trusted = [
  {name: 'Akua', href: 'https://akua.dev/', svg: akuaLogo},
]

// One-click downloads for the hero (same files as the Downloads page).
const rel = 'https://github.com/minekube/connect-java/releases/download/latest'
const downloads = [
  {name: 'Paper / Spigot', short: 'Paper', icon: '/images/logos/paper.png', href: `${rel}/connect-spigot.jar`, cta: 'Download for Paper / Spigot', hint: 'Put connect-spigot.jar in plugins/ and restart.', file: true},
  {name: 'Gate', short: 'Gate', icon: '/minekube-logo.png', href: 'https://gate.minekube.com/guide/connect', cta: 'Enable Connect in Gate', hint: 'Gate has Connect built in: no download, just a config switch.', file: false, rec: true},
  {name: 'Velocity', short: 'Velocity', icon: '/images/logos/velocity.png', href: `${rel}/connect-velocity.jar`, cta: 'Download for Velocity', hint: 'Put connect-velocity.jar in plugins/ and restart.', file: true},
  {name: 'BungeeCord', short: 'Bungee', icon: '/images/logos/spigot.png', href: `${rel}/connect-bungee.jar`, cta: 'Download for BungeeCord', hint: 'Put connect-bungee.jar in plugins/ and restart.', file: true},
]

---

<div class="mk-home not-content">
  <!-- ============ Hero ============ -->
  <section class="hero wrap" aria-labelledby="_top">
    <div class="hero-copy">
      <h1 id="_top"><span class="brand">Minekube Connect</span> Put your server online</h1>
      <p class="lead">Give any Minecraft server a public address and DDoS protection, even one running on your own PC. No port forwarding, no exposed IP.</p>
      <div class="dl" data-dl>
        <p class="dl-label" id="dl-label">Get Connect for</p>
        <ul class="dl-cards" aria-labelledby="dl-label">
          {downloads.map((d) => (
            <li>
              <a class:list={['dl-card', {rec: d.rec}]} href={d.href} {...(d.file ? {download: ''} : {target: '_blank', rel: 'noreferrer'})} aria-label={d.cta}>
                <img src={d.icon} alt="" width="22" height="22" />
                <span class="nm">{d.name}</span><span class="nm-s" aria-hidden="true">{d.short}</span>
                <span class="dl-ico" set:html={d.file ? `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>` : `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>`} />
              </a>
            </li>
          ))}
        </ul>
        <p class="dl-note">Click your platform to download. <span class="dl-ver"></span> <a href="/guide/quick-start">Setup guide</a></p>
      </div>
    </div>

    <figure class="hero-video">
      <div class="ambient" aria-hidden="true">
        <img src="https://i.ytimg.com/vi/jcN9Dvt1zLk/mqdefault.jpg" alt="" width="320" height="180" decoding="async" />
        <canvas width="80" height="45"></canvas>
        <canvas width="80" height="45"></canvas>
      </div>
      <script type="application/json" id="video-board" set:html={JSON.stringify({"sheets": ["https://i.ytimg.com/sb/jcN9Dvt1zLk/storyboard3_L1/M0.jpg?sqp=-oaymwGhAUg48quKqQOYAYgBAZUBAAAEQpgBMqABPKgBBLIBQBANDBAVHyYtDg4PEhcrLCkPDhAVHyoyKQ8RFBgmPTgtERQeKjFLRzYVHCkuOUdNPyUuNz1HUlFFM0BCQ0xERkO6AUARERUjRENDQxETFi9DQ0NDFRYpQ0NDQ0MjL0NDQ0NDQ0RDQ0NDQ0JCQ0NDQ0NCQkJDQ0NDQkJCQkNDQ0JCQkJCovOX_wMGCMvoh8gG&sigh=rs$AOn4CLDiAjlYQ-AXD-LBdcLlVTlO9LQ83Q", "https://i.ytimg.com/sb/jcN9Dvt1zLk/storyboard3_L1/M1.jpg?sqp=-oaymwGhAUg48quKqQOYAYgBAZUBAAAEQpgBMqABPKgBBLIBQBANDBAVHyYtDg4PEhcrLCkPDhAVHyoyKQ8RFBgmPTgtERQeKjFLRzYVHCkuOUdNPyUuNz1HUlFFM0BCQ0xERkO6AUARERUjRENDQxETFi9DQ0NDFRYpQ0NDQ0MjL0NDQ0NDQ0RDQ0NDQ0JCQ0NDQ0NCQkJDQ0NDQkJCQkNDQ0JCQkJCovOX_wMGCMvoh8gG&sigh=rs$AOn4CLDiAjlYQ-AXD-LBdcLlVTlO9LQ83Q"], "w": 80, "h": 45, "count": 129, "cols": 10, "rows": 10, "interval": 5.0})}></script>
      <div class="video-frame">
        <button class="video-play" type="button" data-video="jcN9Dvt1zLk" aria-label="Play video: Self-host a Minecraft server without port forwarding using Minekube Connect">
          <img src="https://i.ytimg.com/vi/jcN9Dvt1zLk/maxresdefault.jpg" alt="" width="1280" height="720" fetchpriority="high" />
          <span class="play" aria-hidden="true"></span>
        </button>
      </div>
      <figcaption>Self-host a Minecraft server without port forwarding. Video by <a href="https://www.youtube.com/@KasaiSora">KasaiSora</a>.</figcaption>
    </figure>
    <a class="scroll-cue" href="#features-title"><span>Scroll down</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
  </section>

  <!-- ============ What you can do ============ -->
  <section class="glance wrap" aria-labelledby="features-title">
    <div class="sec-head">
      <h2 id="features-title">What you can do with Connect</h2>
      <p>Every Minekube Connect feature in one place. Each card opens the guide for it.</p>
    </div>
    <ul>
      {features.map((f, i) => (
        <li class:list={[{big: i === 0, wide: i === 1}]}>
          <a href={f.link}>
            {i === 0 && (
              <span class="viz shield-viz" aria-hidden="true">
                <span class="lane"><i class="bad"></i><i class="ok"></i><i class="bad"></i><i class="ok"></i></span>
                <span class="lane"><i class="ok"></i><i class="bad"></i><i class="bad"></i><i class="ok"></i></span>
                <span class="lane"><i class="bad"></i><i class="bad"></i><i class="ok"></i><i class="bad"></i></span>
                <span class="out"><i></i><i></i><i></i></span>
                <span class="edge"><img src="/minekube-logo.png" alt="" width="34" height="34" /><b>Connect edge</b><small>floods stopped</small></span>
                <span class="you"><span class="dot"></span>Your server<small>IP hidden</small></span>
              </span>
            )}
            {i === 1 && (
              <span class="viz addr-viz" aria-hidden="true">
                <span class="bar"><span class="lock"></span><span><span class="nm">steve</span>.play.minekube.net</span></span>
                <span class="row"><span class="k">Port forwarding</span><span class="v">not needed</span></span>
              </span>
            )}
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[f.icon]} />
            <strong>{f.title}</strong>
            <span>{f.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ How it works: a pipeline of three real windows ============ -->
  <section class="how wrap" aria-labelledby="how-title" data-pf="paper">
    <div class="sec-head">
      <h2 id="how-title">How it works</h2>
      <p>From download to players in three steps. Pick your platform to see where the Connector goes.</p>
    </div>
    <div class="how-pf" role="tablist" aria-label="Platform">
      <span class="pf-pill" aria-hidden="true"></span>
      {pfKeys.map((k, i) => (
        <button role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} data-pf={k}>
          <img src={platforms[k].icon} alt="" width="18" height="18" />{platforms[k].label}
        </button>
      ))}
    </div>

    <div class="flow">
      <article class="st">
        <div class="frag" data-ui aria-hidden="true">
          <p class="frag-bar"><span class="folder-name">my-server</span> / plugins</p>
          <div class="frag-body files">
            <div class="others"></div>
            <div class="row jar"><span class="fi" set:html={fileIco} /><span class="jar-name">connect-spigot.jar</span></div>
          </div>
          <pre class="frag-body cfg"><span class="c"># config.yml</span>
config:
  bind: 0.0.0.0:25565
<span class="typed">connect:
  enabled: true</span></pre>
        </div>
        <h3>Add the Connector</h3>
        <p class="d-add">{platforms.paper.add}</p>
      </article>

      <span class="tunnel" aria-hidden="true"><i></i></span>

      <article class="st">
        <div class="frag" data-ui aria-hidden="true">
          <p class="frag-bar"><span class="folder-name">my-server</span>: console</p>
          <pre class="frag-body log"></pre>
        </div>
        <h3>Start your server</h3>
        <p>The console prints your public address. That is the only thing to share.</p>
      </article>

      <span class="tunnel" aria-hidden="true"><i></i></span>

      <article class="st">
        <div class="frag mc" data-ui aria-hidden="true">
          <p class="frag-bar">Minecraft: Play Multiplayer</p>
          <div class="frag-body">
            <div class="srv">
              <img class="srv-icon" src="/minekube-logo.png" alt="" width="40" height="40" />
              <div class="srv-txt">
                <p class="srv-name">My Server</p>
                <p class="srv-motd"><span class="c6">A Minecraft server</span> <span class="ce">via Connect</span></p>
                <p class="srv-addr">live-beru.play.minekube.net</p>
              </div>
              <span class="ping"><i></i><i></i><i></i><i></i><i></i></span>
            </div>
            <p class="joined">Steve joined the game</p>
          </div>
        </div>
        <h3>Players join</h3>
        <p>They add the address like any server. Connect routes them through its nearest edge to you.</p>
      </article>
    </div>
    <script type="application/json" id="how-data" set:html={JSON.stringify(platforms)}></script>
  </section>

  <!-- ============ Works with your setup ============ -->
  <section class="software wrap" aria-labelledby="software-title">
    <div>
      <h2 id="software-title">Works with your setup</h2>
      <p>Paper, Spigot, Velocity and BungeeCord use the Connect plugin. Gate has Connect built in: switch it on in the config and you are done. Every Connector links your server to the same Connect edge.</p>
      <div class="actions">
        <a class="btn primary" href="/guide/connectors/">Choose a Connector</a>
        <a class="btn" href="https://app.minekube.com/">Open dashboard</a>
      </div>
    </div>
    <figure class="hub" aria-label="Minekube Connect links Gate, Velocity, Paper and Spigot servers">
      <svg class="hub-lines" viewBox="0 0 520 440" aria-hidden="true" preserveAspectRatio="none">
        <path id="l-gate" d="M260 176 C 260 262, 72.8 256, 72.8 340" />
        <path id="l-velocity" d="M260 176 C 260 280, 197.6 284, 197.6 384" />
        <path id="l-paper" d="M260 176 C 260 280, 322.4 284, 322.4 384" />
        <path id="l-spigot" d="M260 176 C 260 262, 447.2 256, 447.2 340" />
        <circle r="4" class="pkt"><animateMotion dur="2.6s" repeatCount="indefinite" begin="0s"><mpath href="#l-gate" /></animateMotion></circle>
        <circle r="4" class="pkt"><animateMotion dur="2.6s" repeatCount="indefinite" begin="-1.95s"><mpath href="#l-velocity" /></animateMotion></circle>
        <circle r="4" class="pkt"><animateMotion dur="2.6s" repeatCount="indefinite" begin="-1.3s"><mpath href="#l-paper" /></animateMotion></circle>
        <circle r="4" class="pkt"><animateMotion dur="2.6s" repeatCount="indefinite" begin="-0.65s"><mpath href="#l-spigot" /></animateMotion></circle>
      </svg>
      <a class="hub-core" href="/guide/" aria-label="What is Minekube Connect">
        <img src="/minekube-logo.png" width="507" height="512" alt="" loading="lazy" />
      </a>
      <a class="node high gate" href="/guide/connectors/gate" style="left:14%"><img src="/minekube-logo.png" alt="" width="28" height="28" /><span>Gate</span></a>
      <a class="node low" href="/guide/connectors/plugin" style="left:38%"><img src="/images/logos/velocity.png" alt="" width="28" height="28" /><span>Velocity</span></a>
      <a class="node low" href="/guide/connectors/plugin" style="left:62%"><img src="/images/logos/paper.png" alt="" width="28" height="28" /><span>Paper</span></a>
      <a class="node high" href="/guide/connectors/plugin" style="left:86%"><img src="/images/logos/spigot.png" alt="" width="28" height="28" /><span>Spigot</span></a>
    </figure>
  </section>

  <!-- ============ Browser Hub ============ -->
  <section class="discover wrap" aria-labelledby="discover-title">
    <figure>
      <img src="/images/browser-hub.webp" width="1600" height="922" decoding="async" loading="lazy" alt="The Browser Hub in Minecraft: a lobby with the banner ‘Browse localhost & public servers!’ and links to the website, the download and Discord" />
    </figure>
    <div>
      <h2 id="discover-title">Get discovered</h2>
      <p>Players browse servers in the Browser Hub. Anyone who joins <strong>minekube.net</strong>, or types <code>/browser</code> on a connected server, lands in one lobby that lists localhost and public servers side by side.</p>
      <p>Listing is free and favours new and smaller servers, so a fresh SMP gets seen too.</p>
      <a class="more" href="/guide/advertising">How advertising works</a>
    </div>
  </section>


  <!-- ============ Testimonials ============ -->
  <section class="words wrap" aria-labelledby="words-title">
    <div class="sec-head">
      <h2 id="words-title">What the community says</h2>
      <p>Server owners and developers who build with Minekube and Gate.</p>
    </div>
    <div class="quotes">
      {testimonials.map((t) => (
        <figure>
          <blockquote><p>“{t.body}”</p></blockquote>
          <figcaption>
            {t.avatar ? <img src={t.avatar} alt="" width="40" height="40" loading="lazy" /> : <span class="ph" aria-hidden="true">{t.name[0]}</span>}
            <span class="who"><strong>{t.name}</strong>{t.handle && <span>@{t.handle}</span>}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>


  <!-- ============ Trusted by ============ -->
  <!-- social proof: logos only, no heading -->
  <section class="trusted wrap" aria-label="Trusted by">
    <ul class="logos">
      {trusted.map((t) => (
        <li>
          <a href={t.href} target="_blank" rel="noopener" aria-label={t.name}>
            <span class="tip" aria-hidden="true">{t.name}</span>
            <span class="mark" set:html={t.svg} />
          </a>
        </li>
      ))}
    </ul>
    <p class="trusted-ask">Building on Minekube? We're open to adding you or our partners here. <a href={discordLink}>Ask on Discord</a></p>
  </section>

  <!-- ============ Team ============ -->
  <section class="mission wrap" aria-labelledby="mission-title">
    <div class="sec-head">
      <h2 id="mission-title">Meet the team</h2>
      <p>An international group of contributors and a dedicated core team build Minekube’s open source projects and services.</p>
    </div>
    <Team showLead={false} />
  </section>
</div>

<script>
  const root = document.querySelector('.mk-home')!
  // Animations always play, also with the OS reduced-motion setting on (site owner's choice).

  // ---- How it works: platform switch, and the pipeline plays left to right ----
  const how = root.querySelector<HTMLElement>('.how')!
  const pfs = JSON.parse(how.querySelector('#how-data')!.textContent!) as Record<string, {label: string; icon: string; folder: string; jar: string; others: string[]; add: string; log: [string, string, number?][]}>
  const q = (sel: string) => how.querySelector<HTMLElement>(sel)!
  let howTimer = 0
  const fillPlatform = (k: string) => {
    const p = pfs[k]
    how.dataset.pf = k
    q('.d-add').textContent = p.add
    how.querySelectorAll('.jar-name').forEach((n) => (n.textContent = p.jar))
    how.querySelectorAll('.folder-name').forEach((n) => (n.textContent = p.folder))
    // clone the jar row so the copies keep the component's scoped styles
    q('.others').replaceChildren(...p.others.map((o) => {
      const r = q('.jar').cloneNode(true) as HTMLElement
      r.classList.replace('jar', 'dim')
      r.querySelector('.jar-name')!.textContent = o
      return r
    }))
    q('.log').innerHTML = p.log.map(([tag, msg, hl], i) =>
      `<span class="ln${hl ? ' hl' : ''}" style="--i:${i}"><span class="tag">[${tag}]</span> ${msg.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</span>`).join('')
  }
  const playHow = () => {
    clearTimeout(howTimer)
    how.classList.remove('run'); void how.offsetWidth; how.classList.add('run')
    howTimer = window.setTimeout(playHow, 10000)
  }
  // the sliding highlight under the selected platform
  const pill = q('.pf-pill')
  const movePill = () => {
    const t = how.querySelector<HTMLElement>('[role=tab][aria-selected=true]')!
    pill.style.width = `${t.offsetWidth}px`; pill.style.height = `${t.offsetHeight}px`
    pill.style.transform = `translate(${t.offsetLeft}px, ${t.offsetTop}px)`
  }
  movePill()
  addEventListener('resize', movePill)
  document.fonts?.ready.then(movePill)
  how.querySelectorAll<HTMLButtonElement>('[role=tab]').forEach((tab) =>
    tab.addEventListener('click', () => {
      how.querySelectorAll('[role=tab]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)))
      movePill()
      fillPlatform(tab.dataset.pf!)
      playHow()
    }))
  fillPlatform('paper')
  new IntersectionObserver((e) => { if (e[0].isIntersecting) playHow(); else clearTimeout(howTimer) }, {threshold: 0.35}).observe(how)

  // ---- Hero downloads: latest version label ----
  const dl = root.querySelector<HTMLElement>('[data-dl]')!
  fetch('https://api.github.com/repos/minekube/connect-java/releases/latest')
    .then((r) => (r.ok ? r.json() : null))
    .then((j) => { if (j?.tag_name) dl.querySelector('.dl-ver')!.textContent = `Latest: v${String(j.tag_name).replace(/^v/, '')}` })
    .catch(() => {})

  // ---- Scroll cue disappears once the visitor scrolls ----
  const cue = root.querySelector<HTMLElement>('.scroll-cue')
  if (cue) {
    const onScroll = () => cue.classList.toggle('gone', scrollY > 40)
    addEventListener('scroll', onScroll, {passive: true})
    onScroll()
  }

  // ---- Click-to-play video with live ambient light ----
  // The YouTube frame cannot be read, so the glow uses the video's storyboard: the
  // preview frame for the current playback time is drawn into a tiny canvas, blurred
  // and cross-faded. Before play (or if the storyboard fails) the thumbnail glows.
  const play = root.querySelector<HTMLButtonElement>('.video-play')!
  const figure = play.closest<HTMLElement>('.hero-video')!
  const board = JSON.parse(document.getElementById('video-board')!.textContent!)
  const canvases = [...figure.querySelectorAll<HTMLCanvasElement>('.ambient canvas')]
  const sheetImgs: (HTMLImageElement | null)[] = []
  let front = 0, lastFrame = -1, boardOk = true
  const loadSheets = () => board.sheets.forEach((src: string, i: number) => {
    if (sheetImgs[i]) return
    const img = new Image()
    img.decoding = 'async'
    img.onerror = () => { boardOk = false; figure.classList.remove('live') }
    img.src = src
    sheetImgs[i] = img
  })
  const drawFrame = (t: number) => {
    if (!boardOk) return
    const idx = Math.min(board.count - 1, Math.max(0, Math.floor(t / board.interval)))
    if (idx === lastFrame) return
    const per = board.cols * board.rows
    const img = sheetImgs[Math.floor(idx / per)]
    if (!img || !img.complete || !img.naturalWidth) return
    const within = idx % per
    const back = canvases[1 - front]
    back.getContext('2d')!.drawImage(img, (within % board.cols) * board.w, Math.floor(within / board.cols) * board.h, board.w, board.h, 0, 0, board.w, board.h)
    back.classList.add('on'); canvases[front].classList.remove('on')
    front = 1 - front; lastFrame = idx
    figure.classList.add('live')
  }
  let ytReady: Promise<void> | null = null
  const loadYT = () => (ytReady ??= new Promise<void>((resolve) => {
    const w = window as any
    if (w.YT?.Player) return resolve()
    const prev = w.onYouTubeIframeAPIReady
    w.onYouTubeIframeAPIReady = () => { prev?.(); resolve() }
    const tag = document.createElement('script')
    tag.src = 'https://www.youtube.com/iframe_api'
    document.head.appendChild(tag)
  }))
  play.addEventListener('pointerenter', () => { loadYT(); loadSheets() }, {once: true})
  play.addEventListener('click', async () => {
    loadSheets()
    const holder = document.createElement('div')
    holder.className = 'yt-holder'
    play.replaceWith(holder)
    figure.classList.add('playing')
    await loadYT()
    const YT = (window as any).YT
    let timer = 0
    new YT.Player(holder, {
      host: 'https://www.youtube-nocookie.com',
      videoId: play.dataset.video,
      playerVars: {autoplay: 1, mute: 1, playsinline: 1, rel: 0, modestbranding: 1},
      events: {
        onReady: (e: any) => { e.target.playVideo(); drawFrame(0) },
        onStateChange: (e: any) => {
          clearInterval(timer)
          if (e.data === YT.PlayerState.PLAYING) timer = window.setInterval(() => drawFrame(e.target.getCurrentTime()), 250)
          else drawFrame(e.target.getCurrentTime())
        },
      },
    })
  })

  // ---- Entrances ----
  {
    root.classList.add('js')
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target) }
    }), {threshold: 0.12})
    root.querySelectorAll('section').forEach((s) => io.observe(s))
  }
</script>

