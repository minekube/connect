  }
  .how-steps button:hover { background: color-mix(in srgb, var(--field-2) 55%, transparent); }
  .how-steps button[aria-current] { background: var(--ground); }
  .how-steps .n { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 0.6rem; background: var(--field-2); font-weight: 700; font-size: 0.9375rem; color: var(--soft); transition: background-color 0.2s ease, color 0.2s ease; }
  .how-steps button[aria-current] .n { background: var(--accent); color: #160a01; }
  .how-steps .tx { display: grid; gap: 0.2rem; }
