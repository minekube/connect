---
import {getCollection} from 'astro:content'

const posts = (await getCollection('docs', (e) => e.id.startsWith('blog/') && e.data.date))
  .sort((a, b) => +b.data.date! - +a.data.date!)
const fmt = (d: Date) => d.toLocaleDateString('en-US', {year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'})
const authorOf = (a: unknown) => (typeof a === 'string' ? {name: a} : (a as {name: string; role?: string; imageUrl?: string}) ?? {name: 'Minekube'})
const {entry} = Astro.locals.starlightRoute
---

<section class="mk-posts not-content">
  <div class="intro">
    <p class="lead">{entry.data.subtext}</p>
    <a class="rss" href="/feed.rss" target="_blank" rel="noreferrer">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4a15 15 0 0 1 15 15h-3A12 12 0 0 0 5 7V4Zm0 6a9 9 0 0 1 9 9h-3a6 6 0 0 0-6-6v-3Zm2 7a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"></path></svg>
      Subscribe by RSS
    </a>
  </div>
  <ul>
    {posts.map((p) => {
      const a = authorOf(p.data.author)
      return (
        <li>
          <a href={`/${p.id}`} class="card">
            {p.data.imageUrl && <img src={p.data.imageUrl} alt={p.data.imageAlt ?? ''} loading="lazy" width="1200" height="630" />}
            <p class="meta"><time datetime={p.data.date!.toISOString()}>{fmt(p.data.date!)}</time>{p.data.category && <span>{p.data.category}</span>}</p>
            <h3>{p.data.title}</h3>
            {p.data.description && <p class="desc">{p.data.description}</p>}
            <p class="author">
              {a.imageUrl && <img src={a.imageUrl} alt="" width="28" height="28" loading="lazy" />}
              <span>{a.name}{a.role && <small> · {a.role}</small>}</span>
            </p>
          </a>
        </li>
      )
    })}
  </ul>
</section>

<style>
  .mk-eyebrow { font-family: var(--mk-font-pixel); text-transform: uppercase; letter-spacing: 0.05em; color: var(--sl-color-accent); font-size: 0.85rem; margin: 0; }
  .intro { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
  .intro .mk-eyebrow { flex-basis: 100%; }
  .lead { margin: 0; color: var(--sl-color-gray-2); font-size: 1.1rem; }
  .rss { display: inline-flex; gap: 0.5rem; align-items: center; padding: 0.5rem 0.9rem; border: 1px solid var(--sl-color-hairline-light); border-radius: 0.375rem; color: var(--sl-color-white); text-decoration: none; font-size: 0.875rem; font-weight: 600; }
  .rss:hover { border-color: var(--sl-color-accent); }
  .rss svg { width: 1rem; height: 1rem; fill: var(--mk-orange); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .card { display: flex; flex-direction: column; height: 100%; padding: 0.75rem 0.75rem 1.25rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.75rem; text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s; background: color-mix(in srgb, var(--sl-color-gray-6) 50%, transparent); }
  .card:hover { border-color: var(--sl-color-accent); transform: translateY(-2px); }
  .card > img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0.5rem; }
  .meta { display: flex; gap: 0.6rem; align-items: center; margin: 1rem 0.5rem 0; font-family: var(--sl-font-mono); font-size: 0.75rem; color: var(--sl-color-gray-3); }
  .meta span { padding: 0.1rem 0.45rem; border-radius: 0.25rem; background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent); color: var(--sl-color-accent-high); }
  :root[data-theme='light'] .meta span { color: var(--sl-color-accent); }
  h3 { margin: 0.6rem 0.5rem 0; font-size: 1.15rem; line-height: 1.35; color: var(--sl-color-white); letter-spacing: -0.01em; }
  .desc { margin: 0.6rem 0.5rem 0; font-size: 0.9rem; color: var(--sl-color-gray-2); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .author { margin: auto 0.5rem 0; padding-top: 1rem; display: flex; gap: 0.5rem; align-items: center; font-size: 0.85rem; color: var(--sl-color-white); }
  .author img { border-radius: 0.25rem; }
  .author small { color: var(--sl-color-gray-3); }
</style>
