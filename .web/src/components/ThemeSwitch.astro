---
// Replaces Starlight's theme dropdown with a two-state switch (dark / light).
// Starlight reads the same localStorage key on load, so the choice persists.
---

<mk-theme-switch>
  <button type="button" role="switch" aria-checked="false" aria-label="Light theme" class="mk-switch">
    <span class="track" aria-hidden="true">
      <svg class="i moon" viewBox="0 0 24 24"><path fill="currentColor" d="M21 14.5A9 9 0 0 1 9.5 3a7.5 7.5 0 1 0 11.5 11.5Z" /></svg>
      <svg class="i sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></svg>
      <span class="knob"></span>
    </span>
  </button>
</mk-theme-switch>

<script>
  class MkThemeSwitch extends HTMLElement {
    constructor() {
      super()
      const btn = this.querySelector('button')!
      const current = () => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark')
      const sync = () => btn.setAttribute('aria-checked', String(current() === 'light'))
      sync()
      btn.addEventListener('click', () => {
        const next = current() === 'light' ? 'dark' : 'light'
        document.documentElement.dataset.theme = next
        try { localStorage.setItem('starlight-theme', next) } catch {}
        document.querySelectorAll('mk-theme-switch button').forEach((b) => b.setAttribute('aria-checked', String(next === 'light')))
      })
    }
  }
  customElements.define('mk-theme-switch', MkThemeSwitch)
</script>

<style>
  mk-theme-switch { display: inline-flex; }
  .mk-switch { all: unset; cursor: pointer; display: inline-flex; border-radius: 999px; }
  .mk-switch:focus-visible { outline: 2px solid var(--mk-orange); outline-offset: 3px; }
  .track {
    position: relative; width: 3.25rem; height: 1.75rem; border-radius: 999px; background: var(--sl-color-gray-6);
    display: flex; align-items: center; justify-content: space-between; padding: 0 0.4rem; box-sizing: border-box;
    transition: background-color 0.2s ease;
  }
  .mk-switch:hover .track { background: var(--sl-color-gray-5); }
  .i { width: 0.85rem; height: 0.85rem; color: var(--sl-color-gray-3); position: relative; z-index: 0; }
  .knob {
    position: absolute; top: 0.2rem; left: 0.2rem; width: 1.35rem; height: 1.35rem; border-radius: 50%;
    background: var(--sl-color-white); z-index: 1; transition: transform 0.22s cubic-bezier(.4,0,.2,1);
  }
  .mk-switch[aria-checked='true'] .knob { transform: translateX(1.5rem); background: var(--mk-orange); }
  @media (prefers-reduced-motion: reduce) { .knob { transition: none; } }
</style>
