---
// Replaces Starlight's theme dropdown with a two-state switch (dark / light).
// Both icons stay visible; a pill slides under the active one. Starlight reads the
// same localStorage key on load, so the choice persists.
---

<mk-theme-switch>
  <button type="button" role="switch" aria-checked="false" aria-label="Light theme" class="mk-switch">
    <span class="track" aria-hidden="true">
      <span class="pill"></span>
      <svg class="i moon" viewBox="0 0 24 24"><path fill="currentColor" d="M20 14.6A8.5 8.5 0 0 1 9.4 4a8 8 0 1 0 10.6 10.6Z" /></svg>
      <svg class="i sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.2" fill="currentColor" /><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
    </span>
  </button>
</mk-theme-switch>

<script>
  class MkThemeSwitch extends HTMLElement {
    constructor() {
      super()
      const btn = this.querySelector('button')!
      const current = () => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark')
      btn.setAttribute('aria-checked', String(current() === 'light'))
      btn.addEventListener('click', () => {
        const next = current() === 'light' ? 'dark' : 'light'
        // switch without colours animating halfway through the change
        const root = document.documentElement
        root.classList.add('mk-theme-switching')
        root.dataset.theme = next
        requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('mk-theme-switching')))
        try { localStorage.setItem('starlight-theme', next) } catch {}
        document.querySelectorAll('mk-theme-switch button').forEach((b) => b.setAttribute('aria-checked', String(next === 'light')))
      })
    }
  }
  customElements.define('mk-theme-switch', MkThemeSwitch)
</script>

<style>
  mk-theme-switch { display: inline-flex; }
  .mk-switch { all: unset; cursor: pointer; display: inline-flex; border-radius: 999px; }
  .mk-switch:focus-visible { outline: 2px solid var(--mk-orange); outline-offset: 3px; }
  .track {
    position: relative; display: grid; grid-template-columns: 1fr 1fr; align-items: center;
    width: 4rem; height: 2rem; padding: 0.2rem; box-sizing: border-box; border-radius: 999px;
    background: var(--sl-color-gray-5);
  }
  .pill {
    position: absolute; top: 0.2rem; left: 0.2rem; width: calc(50% - 0.2rem); height: calc(100% - 0.4rem); border-radius: 999px;
    background: var(--sl-color-black); transition: transform 0.22s cubic-bezier(.4,0,.2,1);
  }
  .mk-switch[aria-checked='true'] .pill { transform: translateX(100%); }
  .i { position: relative; z-index: 1; justify-self: center; width: 0.95rem; height: 0.95rem; color: var(--sl-color-gray-3); transition: color 0.2s ease; }
  .mk-switch[aria-checked='false'] .moon { color: var(--sl-color-white); }
  .mk-switch[aria-checked='true'] .sun { color: var(--mk-orange); }
  .mk-switch:hover .track { background: var(--sl-color-gray-4); }
  @media (prefers-reduced-motion: reduce) { .pill { transition: none; } }
</style>
