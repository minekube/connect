---
// 8x8 pixel-art icons drawn from text masks: '#' = solid, '+' = accent (half opacity).
const icons: Record<string, string[]> = {
  shield: ['.######.', '#++++++#', '#++##++#', '#+####+#', '#++##++#', '.#++++#.', '..#++#..', '...##...'],
  tunnel: ['..####..', '.#....#.', '#..++..#', '#.+..+.#', '#.+..+.#', '#.+..+.#', '#.+..+.#', '########'],
  laptop: ['.######.', '.#++++#.', '.#++++#.', '.#++++#.', '.######.', '........', '########', '.######.'],
  sparkle: ['...#....', '...#....', '..+#+...', '###+###.', '..+#+..#', '...#..###', '...#...#', '........'],
  network: ['##....##', '#+#..#+#', '.#.##.#.', '..#++#..', '..#++#..', '.#.##.#.', '#+#..#+#', '##....##'],
  controller: ['........', '.######.', '#++++++#', '#+#++#+#', '###+####', '#+#++#+#', '#++##++#', '.##..##.'],
  chest: ['.######.', '#++++++#', '#++++++#', '###++###', '###..###', '#++++++#', '#++++++#', '########'],
  megaphone: ['......#.', '....##+#', '.###++.#', '#+++++.#', '#+++++.#', '.###++.#', '..#.##+#', '..#...#.'],
  scroll: ['.######.', '#++++++#', '.#####+.', '.#++++#.', '.#####+.', '.#++++#.', '#++++++#', '.######.'],
  clover: ['.##..##.', '#++##++#', '#++##++#', '.######.', '.######.', '#++##++#', '#++##++#', '.##..##.'],
}
const {name, size = 24} = Astro.props as {name: keyof typeof icons; size?: number}
const rows = icons[name] ?? []
---

<svg width={size} height={size} viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true" class="mk-pixel-icon">
  {rows.flatMap((row, y) => [...row.slice(0, 8)].map((c, x) =>
    c === '#' ? <rect x={x} y={y} width="1" height="1" fill="currentColor" />
    : c === '+' ? <rect x={x} y={y} width="1" height="1" fill="currentColor" opacity="0.4" /> : null))}
</svg>
