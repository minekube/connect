---
import config from 'virtual:starlight/user-config'
import Search from 'virtual:starlight/components/Search'
import SiteTitle from 'virtual:starlight/components/SiteTitle'
import ThemeSwitch from './ThemeSwitch.astro'

const nav = [
  {text: 'Docs', link: '/guide/', match: /^\/guide\/(?!connectors)/},
  {text: 'Connectors', link: '/guide/connectors/', match: /^\/guide\/connectors/},
  {text: 'Plans', link: '/plans', match: /^\/plans/},
  {text: 'Changelog', link: '/changelog/', match: /^\/changelog/},
  {text: 'Blog', link: '/blog/', match: /^\/blog/},
]
const path = Astro.url.pathname
// Splash pages (home, plans, changelog, blog) have no sidebar, so no Starlight mobile menu.
const mobileNav = !Astro.locals.starlightRoute.hasSidebar
const shouldRenderSearch = config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro'
---

<div class="mk-header">
  <div class="title-wrapper"><SiteTitle /></div>
  <nav class="mk-nav" aria-label="Main">
    {nav.map((n) => <a href={n.link} aria-current={n.match.test(path) ? 'page' : undefined}>{n.text}</a>)}
  </nav>
  <div class="right print:hidden">
    {shouldRenderSearch && <div class="search"><Search /></div>}
    <div class="theme"><ThemeSwitch /></div>
    <a class="mk-dash" href="https://app.minekube.com">Dashboard</a>
    {mobileNav && (
      <details class="mk-mobile-nav">
        <summary aria-label="Menu">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"></path></svg>
        </summary>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.link} aria-current={n.match.test(path) ? 'page' : undefined}>{n.text}</a>)}
          <a href="/team">Team</a>
          <a href="https://gate.minekube.com">Gate Proxy</a>
          <div class="mobile-theme"><span>Theme</span><ThemeSwitch /></div>
          <a href="https://app.minekube.com" class="dash">Dashboard</a>
        </nav>
      </details>
    )}
  </div>
</div>

<script>
  // Smooth, inertial scrolling (Lenis) on mouse/trackpad; touch keeps native scrolling.
  // Nested scroll areas keep their own scrolling; reduced-motion users get the browser default.
  import Lenis from 'lenis'
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lenis = new Lenis({
      autoRaf: true,
      lerp: 0.2,
      wheelMultiplier: 1,
      anchors: {offset: -80},
      prevent: (node: HTMLElement) => !!node.closest?.('.sidebar-pane, .mk-sd, pre, .expressive-code, .scroll, .cl-dd-menu, starlight-toc, mobile-starlight-toc, .mk-mobile-nav nav, dialog, .right-sidebar'),
    })
    const root = document.documentElement
    new MutationObserver(() => (root.classList.contains('mk-sd-lock') ? lenis.stop() : lenis.start())).observe(root, {attributes: true, attributeFilter: ['class']})
  }
</script>

<style>
  .mk-header {
    display: flex; align-items: center; gap: 1.5rem; height: 100%;
    max-width: var(--mk-page-width); margin-inline: auto;
  }
  .title-wrapper { display: flex; min-width: 0; flex: 0 1 auto; overflow: hidden; }
  @media (max-width: 50rem) { .mk-header { gap: 0.75rem; } .right { gap: 0.5rem; } }
  .mk-nav { display: none; gap: 0.25rem; }
  .mk-nav a {
    padding: 0.4rem 0.8rem; border-radius: 999px; font-size: 0.9375rem; font-weight: 550;
    color: var(--sl-color-gray-2); text-decoration: none; transition: color 0.15s ease, background-color 0.15s ease;
  }
  .mk-nav a:hover { color: var(--sl-color-white); background: var(--sl-color-gray-6); }
  .mk-nav a[aria-current='page'] { color: var(--sl-color-white); background: var(--sl-color-gray-6); }
  .right { margin-left: auto; display: flex; align-items: center; gap: 0.75rem; }
  .search { display: flex; }
  .theme { display: none; }
  .mk-dash {
    display: none; padding: 0.5rem 1.05rem; border-radius: 999px; font-size: 0.9375rem; font-weight: 650; white-space: nowrap;
    color: #160a01; background: var(--mk-orange); text-decoration: none; transition: background-color 0.15s ease;
  }
  .mk-dash:hover { background: #ff9440; }
  .mk-mobile-nav { position: relative; }
  .mk-mobile-nav summary { list-style: none; cursor: pointer; display: flex; padding: 0.4rem; color: var(--sl-color-white); border-radius: 0.5rem; }
  .mk-mobile-nav summary::-webkit-details-marker { display: none; }
  .mk-mobile-nav nav {
    position: fixed; left: 0; right: 0; top: var(--sl-nav-height); z-index: 10; display: grid; gap: 0.15rem;
    padding: 0.75rem var(--mk-gutter) 1.25rem; background: var(--sl-color-black);
    border-bottom: 1px solid var(--sl-color-hairline); box-shadow: 0 24px 40px rgb(0 0 0 / 0.45);
    max-height: calc(100dvh - var(--sl-nav-height)); overflow-y: auto; box-sizing: border-box;
  }
  .mk-mobile-nav nav a { padding: 0.85rem 0.9rem; border-radius: 0.6rem; color: var(--sl-color-gray-1); text-decoration: none; font-weight: 600; font-size: 1.0625rem; }
  .mk-mobile-nav nav a:hover, .mk-mobile-nav nav a[aria-current='page'] { background: var(--sl-color-gray-5); color: var(--sl-color-white); }
  .mk-mobile-nav nav a.dash { margin-top: 0.75rem; background: var(--mk-orange); color: #160a01; font-weight: 650; text-align: center; }
  .mobile-theme { display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0.9rem; color: var(--sl-color-gray-1); font-weight: 600; font-size: 1.0625rem; }
  @media (min-width: 50rem) {
    .theme, .mk-dash { display: flex; }
    .mk-mobile-nav { display: none; }
  }
  @media (min-width: 50rem) { .title-wrapper { flex: none; } }
  @media (min-width: 64rem) { .mk-nav { display: flex; } }
  /* between tablet and wide desktop the search shows as an icon so the logo never squeezes */
  @media (min-width: 50rem) and (max-width: 72rem) {
    .search :global(.mk-search-label), .search :global(.mk-search-kbd) { display: none !important; }
    .search :global(button[data-open-modal]) { width: 2.5rem; padding: 0; justify-content: center; }
  }
</style>
