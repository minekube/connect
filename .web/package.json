{
  "name": "connect-minekube-docs",
  "type": "module",
  "version": "1.0.0",
  "author": "Minekube",
  "scripts": {
    "dev": "astro dev",
    "check:docs": "node scripts/check-docs.mjs",
    "check:changelog-layout": "yarn build && node scripts/check-changelog-layout.mjs",
    "check:llms": "node scripts/check-llms.mjs",
    "check:plugin-download": "node scripts/check-plugin-download.mjs",
    "build": "astro build && node scripts/check-llms.mjs",
    "test:worker": "node --test scripts/workers-migration.test.mjs",
    "deploy:worker": "wrangler deploy",
    "deploy:worker:canary": "wrangler deploy --config wrangler.canary.jsonc",
    "preview": "astro preview",
    "serve": "astro preview"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/starlight": "0.43.1",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@astrojs/vue": "7.1.6",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.12",
    "feed": "^6.0.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "4.3.5",
    "vue": "^3.5.41",
    "wrangler": "4.115.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.5",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "globe.gl": "^2.46.1",
    "lenis": "^1.3.27",
    "posthog-js": "^1.413.3",
    "three": "^0.185.1"
  },
  "packageManager": "yarn@4.17.1"
}
