{
  "name": "connect-minekube-docs",
  "type": "module",
  "version": "1.0.0",
  "author": "Minekube",
  "scripts": {
    "dev": "vitepress dev docs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:changelog-layout": "yarn build && node scripts/check-changelog-layout.mjs",
    "check:llms": "node scripts/check-llms.mjs",
    "check:plugin-download": "node scripts/check-plugin-download.mjs",
    "build": "vitepress build docs && node scripts/check-llms.mjs",
    "test:worker": "node --test scripts/workers-migration.test.mjs",
    "deploy:worker": "wrangler deploy",
    "deploy:worker:canary": "wrangler deploy --config wrangler.canary.jsonc",
    "serve": "vitepress serve docs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "feed": "^6.0.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.13.4",
    "vue": "^3.5.41",
    "wrangler": "4.115.0"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "dependencies": {
    "globe.gl": "^2.46.1",
    "posthog-js": "^1.413.3",
    "three": "^0.185.1"
  },
  "packageManager": "yarn@4.17.1"
}
