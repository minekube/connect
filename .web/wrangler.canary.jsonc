{
  "name": "connect-minekube-worker-canary",
  "compatibility_date": "2026-08-07",
  "main": "worker.mjs",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "connect-docs-canary.minekube.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "docs/.vitepress/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*.html",
      "/guide/*",
      "/changelog/*",
      "/discord",
      "/discord/"
    ]
  }
}
